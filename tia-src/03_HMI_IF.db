DATA_BLOCK "HMI_IF"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
   VAR
      // ---- Buttons / inputs (HMI writes; FB10 resets button bits after evaluating them) ----
      SwOn : Bool;                          // main switch level (HMI InvertBit), TRUE = ON
      BtnInit : Bool;                       // INITIAL STATE (POCETNO STANJE)
      BtnAuto : Bool;
      BtnSemi : Bool;
      BtnManual : Bool;
      BtnStart : Bool;
      BtnStop : Bool;
      BtnAck : Bool;
      BtnStep : Bool;                       // SEMI: run the next manipulation
      BtnManExec : Bool;                    // MANUAL: execute ManCmd
      ManCmd : USInt;                       // 1 lift, 2 put down, 3 move, 10 reset
      ManX : SInt;                          // 0..3
      ManY : SInt;                          // 0..11
      ManBay : USInt;                       // 0 ship, 1 yard
      CfgOrderMode : USInt := 1;            // 0 free, 1 per-list order (default, hedge), 2 strict; FB10 falls back 2->1->0 if infeasible
      CfgSemiPerTransfer : Bool;            // SEMI click = one command (FALSE) or one transfer (TRUE)
      CfgBalMode : USInt;                   // 0 x-halves, 1 also y-halves
      AlarmHmiAck : Word;                   // WinCC 'Acknowledgement tag': alarm acknowledged in the alarm view (= POTVRDA); FB10 resets it
      // ---- Indicators (FB10 writes every OB1 cycle) ----
      State : USInt;                        // 0 OFF,1 INIT,2 READY,3 RUNNING,4 PAUSED,5 ALARM,6 DONE,7 PLANNING
      Mode : USInt := 1;                      // 1 AUTO, 2 SEMI, 3 MANUAL
      LampOn : Bool;
      LampOff : Bool;
      LampReady : Bool;
      LampAuto : Bool;
      LampSemi : Bool;
      LampManual : Bool;
      LampRunning : Bool;
      LampAlarm : Bool;
      LampDone : Bool;
      Initialized : Bool;
      CraneBusy : Bool;
      Planning : Bool;
      StepWaiting : Bool;                   // SEMI is waiting for a click
      M : UDInt;                            // v1.7: M by the spec rule (x and y change = 2) = World.MSpec (primary)
      T : Real;                             // = "time" (MD112) working time [s]
      J : Real;                             // v1.7: 0.5*T/(76*N) + 0.5*M/(4*N) with the spec M (primary)
      MSpec : UDInt;                        // = M (spec rule, computed in OB30); kept for compatibility
      JSpec : Real;                         // = J (spec rule); kept for compatibility
      MFb1 : UDInt;                         // v1.7: FB1's own counter "number_of_manipulations" (MD107, +1 per command)
      JFb1 : Real;                          // v1.7: J with MFb1 (secondary)
      OrderModeAct : USInt;                 // order mode actually used by the last plan (after fallback)
      OrderFallback : Bool;                 // v1.4: preferred order/balance mode infeasible, plan uses a weaker one
      SlotAccepts : DInt;                   // v1.4: SLOT phase accepted drop-cell changes (last plan)
      N : Int;
      PredM : DInt;
      PredT : Real;
      PredJ : Real;
      PredJ0 : Real;                        // v1.3: greedy J before the improve phase
      LbJ : Real;                           // v1.3: lower bound of J (no plan can be better)
      GapPct : Real;                        // v1.3: (PredJ / LbJ - 1) * 100
      ImpGainPct : Real;                    // v1.3: (1 - PredJ / PredJ0) * 100 = gain of the improve phase
      ImpEvals : DInt;                      // v1.3: improve-phase evaluations of the last plan
      PlanProgress : Int;                   // v1.3: planner progress 0..100 % (improve phase)
      PlanVariant : Int;
      TrDone : Int;
      TrTotal : Int;
      UDone : Int;
      UTotal : Int;
      LDone : Int;
      LTotal : Int;
      CraneX : SInt;
      CraneY : SInt;
      CraneBay : USInt;
      CraneGX : Int;                        // global column: x+6 if bay 0 else x (0..9)
      Carried : UInt;
      CurCmd : USInt;
      CurX : SInt;
      CurY : SInt;
      CurBay : USInt;
      CurId : UInt;
      CurKind : USInt;                      // 1 unload, 2 load, 0 none
      CurPhase : USInt;
      Cell0 : Array[0..47] of UInt;         // Bay0 IDs, index x*12+y
      Cell1 : Array[0..47] of UInt;         // Bay1 IDs, index x*12+y
      CellSt0 : Array[0..47] of USInt;      // colour code 0..7
      CellSt1 : Array[0..47] of USInt;
      UList : Array[1..48] of UInt;
      LList : Array[1..48] of UInt;
      UState : Array[1..48] of USInt;       // 0 pending, 1 done, 2 skipped, 3 in progress
      LState : Array[1..48] of USInt;
      BalL : Int;
      BalR : Int;
      BalDiff : Int;                        // BalL - BalR
      BalF : Int;
      BalA : Int;
      BalOk : Bool;                         // |BalDiff| <= 5
      AlarmWord : Word;                     // alarm bits (CONTRACT 3.3)
      AlarmAckWord : Word;                  // WinCC 'PLC acknowledgement tag' = NOT AlarmWord (one ACK clears PLC and HMI)
      AlarmId : UInt;
      AlarmWord2 : Word;                    // v1.4: extra alarm bits: bit 0 = list order abandoned (warning); v1.5 bit 1 = relaxed balance rule (ship loaded unbalanced)
      AlarmUId : UInt;                      // v1.4: first unload-list ID that is not in Bay 0 (alarm bit 3)
      AlarmUCnt : Int;                      //       number of such IDs
      AlarmLId : UInt;                      // v1.4: first load-list ID that is not in Bay 1 (alarm bit 4)
      AlarmLCnt : Int;
      AlarmX : SInt;
      AlarmY : SInt;
      AlarmBay : USInt;
      AlarmHist : Array[0..15] of Int;      // alarm bit numbers of the last 16 raises, [0] newest
      AlarmHistSeq : UDInt;
      OB30Ticks : UDInt;
      Heartbeat : Bool;                     // toggles each OB30 tick
   END_VAR


BEGIN

END_DATA_BLOCK


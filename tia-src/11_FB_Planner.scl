FUNCTION_BLOCK "Crane_Planner"
TITLE = Greedy transfer planner with lookahead and multi-start (CONTRACT 4)
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
//  Multi-instance "Planner" inside FB10 "Crane_Control", called once per OB1 cycle.
//  Python reference tools/crane_plan.py (CONTRACT section 4); mirrored line by line by tia-src/12_planner_mirror.py
//  (greedy + FtMask) and 13_improve_mirror.py (IMPROVE + SLOT + bound, run at a 400-evaluation budget, 3 per call;
//  crane_stress uses 600). Not run on a PLC yet. All decisions use DInt.
//
//  Protocol:
//   - Req rising edge: snapshot "World" (grids, crane, lists/states, N, Base*, Cfg*) into statics.
//     Nothing else is done in that call.
//   - Every following call runs CfgStepsPerCall greedy steps (one transfer each) of the current
//     variant v = 1..CfgVariants (alpha = CfgAlpha[v]). Initialising/closing a variant is free.
//   - When the last variant is closed, the best one (smallest K, lower v on ties) is written to
//     "World".Plan/PlanLen/PlanValid/PlanVariant/PredT_ds/PredM/PredJ and Done := TRUE.
//     On failure: PlanValid := FALSE, PlanLen := 0, PlanVariant := 0, Error := TRUE, ErrCode.
//   - Done / Error stay TRUE while Req stays TRUE. Req = FALSE clears them; Req = FALSE during a job
//     aborts the job without touching "World".
//  ErrCode: 1 no feasible transfer, 2 plan > 96 transfers, 3 bad config / input
//           (also: pending list entry with ID 0 or not found in its bay, crane position invalid),
//           4 crane carrying ("World".Carried <> 0).
//  Calls per job <= 1 + (number of transfers) * CfgVariants  (<= 385 with 96 transfers, 4 variants)
//                   + CfgImproveEvals / CfgImprovePerCall  (IMPROVE phase, v1.3).
//
//  v1.3 (CONTRACT 4.8 / 4.9, Python reference tools/crane_plan.py improve() / lower_bound(),
//  line-by-line mirror tia-src/13_improve_mirror.py):
//   - IMPROVE: after the variants, a deterministic first-improvement local search over the ORDER of
//     the winning plan (move 0 re-slot, 1 relocate, 2 swap, 3 relocate pair; order mode 1 keeps each
//     list in order, order mode 2 skips the phase). Each candidate is replayed with the slot rule
//     min W(s->d) + W(d->next source) under the same balance rules (step rule, Pass A reachability).
//     Accept iff K < incumbent K, so the published plan is never worse than the greedy one.
//     Work per call: <= CfgImprovePerCall replays (each <= 96 steps x 2 x 48 cells) and <= 3000
//     iterator positions; the result does not depend on how the work is split over calls.
//   - Lower bound (REGION 1): closed form T >= 400 P + 60 X_min, M >= 4P - [crane at a source];
//     published as World.LbT_ds / LbM / LbJ together with the plan.
//
//  Speed-ups (results identical to the literal definition):
//   - WTab[dG, dy, xd] = T + 190*M for every |dG| 0..9, |dy| 0..11, x changed (xd) 0/1,
//     built once per job with FC20 "Crane_MoveCost" (the only cost formula).
//   - OrderMode 0: Nx = min over ES \ {s}. Per free cell d, the best and the second-best
//     W(d -> s') over ES are computed once per step; Nx = best unless best belongs to s.
//   - Alpha = 0: Nx is not needed (its weight is zero).
   VAR_INPUT
      Req : Bool;                               // rising edge starts a job
   END_VAR
   VAR_OUTPUT
      Busy : Bool;                              // job running
      Done : Bool;                              // job finished OK (World.Plan valid)
      Error : Bool;                             // job failed (see ErrCode)
      ErrCode : Int;                            // 0 ok, 1 infeasible, 2 > 96 transfers, 3 bad cfg/input, 4 carrying
   END_VAR
   VAR
      ReqOld : Bool;
      JobBusy : Bool;                           // job running (copied to Busy at the end of each call)
      // ---------- snapshot taken at the Req edge ----------
      sG : Array[0..1, 0..3, 0..11] of UInt;   // [bay, x, y] grids (0 ship, 1 yard)
      sCx : Int;                                // crane at plan time
      sCy : Int;
      sCb : Int;
      sBaseT : DInt;                            // World.BaseT_ds
      sBaseM : DInt;                            // World.BaseM
      sN : Int;                                 // World.N (for PredJ)
      cMMode : Int;
      cOrder : Int;
      cBalMode : Int;
      cLim : Int;
      cCeil : Int;                              // v1.5 (R2-J1): relaxed balance ceiling (0 = step rule only)
      cVariants : Int;
      cSteps : Int;
      cAlpha : Array[1..4] of DInt;
      nSrc : Int;                               // pending entries: unloads (index order) first, then loads
      SrcKind : Array[1..96] of USInt;          // 1 unload, 2 load
      SrcIdx : Array[1..96] of Int;             // list index
      SrcId : Array[1..96] of UInt;
      SrcX : Array[1..96] of Int;               // position at plan time (never changes while pending)
      SrcY : Array[1..96] of Int;
      SrcB : Array[1..96] of Int;
      SrcG : Array[1..96] of Int;               // global column
      WTab : Array[0..9, 0..11, 0..1] of DInt;  // weighted move cost T + 190*M by |dG|, |dy|, x changed
      // ---------- variant state ----------
      VarNo : Int;                              // current variant 1..cVariants
      VarActive : Bool;                         // variant initialised
      VarErr : Int;                             // error of the current variant (0 ok)
      Alpha : DInt;
      g : Array[0..1, 0..3, 0..11] of UInt;    // working grids
      Pend : Array[1..96] of Bool;              // source still pending
      nPend : Int;
      cx : Int;                                 // crane
      cy : Int;
      cb : Int;
      cG : Int;
      TotT : DInt;                              // running totals incl. Base
      TotM : DInt;
      CurLen : Int;
      CurPlan : Array[1..96] of "typeTransfer";
      Err1 : Int;                               // error of variant 1 (reported if all variants fail)
      HaveBest : Bool;
      BestV : Int;
      BestK : DInt;
      BestT : DInt;
      BestM : DInt;
      BestLen : Int;
      BestPlan : Array[1..96] of "typeTransfer";
      // ---------- per-step scratch ----------
      Es : Array[1..96] of Int;                 // eligible sources (source numbers) in ES order
      nEs : Int;
      nFree : Array[0..1] of Int;
      FreeX : Array[0..1, 1..48] of Int;        // free cells per bay, x 0..3 outer / y 0..11 inner
      FreeY : Array[0..1, 1..48] of Int;
      FreeG : Array[0..1, 1..48] of Int;
      B1 : Array[0..1, 1..48] of DInt;          // OrderMode 0: best W(d -> s') over ES
      B1Own : Array[0..1, 1..48] of Int;        //   its source number
      B2 : Array[0..1, 1..48] of DInt;          //   second best (-1 = none)
      // ---------- diagnostics (read-only, not used by the algorithm) ----------
      DiagCalls : DInt;                         // calls of the last job (incl. the edge call)
      DiagSteps : DInt;                         // greedy steps of the last job
      DiagCallMs : LReal;                       // duration of the last working call [ms]
      DiagMaxCallMs : LReal;                    // longest working call of the last job [ms]
      DiagJobMs : LReal;                        // sum of working-call durations of the last job [ms]
      DiagVarK : Array[1..4] of DInt;           // K of each variant (-1 = failed)
      DiagVarErr : Array[1..4] of Int;          // error of each variant
      RtMem : LReal;                            // RUNTIME memory
      ZeroTr : "typeTransfer";                  // never written: used to clear World.Plan entries
      // ---------- v1.3: IMPROVE phase (CONTRACT 4.8) + lower bound (4.9) ----------
      cImpEvals : DInt;                         // World.CfgImproveEvals (0 = no improve phase)
      cImpDist : Int;                           // World.CfgImproveDist (max |i-j|, 0 = unlimited)
      cImpPerCall : Int;                        // World.CfgImprovePerCall (evaluations per OB1 call, >= 1)
      CurSrc : Array[1..96] of Int;             // source number of each CurPlan step
      BestSrc : Array[1..96] of Int;            // source number of each BestPlan step
      PubPending : Bool;                        // job result ready to be published
      ImpActive : Bool;                         // improve phase running
      ImpEvals : DInt;                          // evaluations done
      ImpAcc : DInt;                            // accepted candidates
      GrT : DInt;                               // greedy winner T / M (before improve)
      GrM : DInt;
      LbT : DInt;                               // lower bound of the pending work (without Base)
      LbM : DInt;
      LsN : Int;                                // incumbent: sequence of source numbers + per-step result
      LsK : DInt;
      LsSeq : Array[1..96] of Int;
      LsDX : Array[1..96] of Int;
      LsDY : Array[1..96] of Int;
      LsDB : Array[1..96] of Int;
      LsT : Array[0..96] of DInt;               // [0] = sBaseT
      LsM : Array[0..96] of DInt;               // [0] = sBaseM
      CdSeq : Array[1..96] of Int;              // candidate
      CdDX : Array[1..96] of Int;
      CdDY : Array[1..96] of Int;
      CdDB : Array[1..96] of Int;
      CdT : Array[1..96] of DInt;
      CdM : Array[1..96] of DInt;
      ItMv : Int;                               // neighbourhood iterator: move 0..3, i, j
      ItI : Int;
      ItJ : Int;
      ItSweepImp : Bool;                        // an improvement was accepted in this sweep
      // ---------- v1.4: exact order feasibility (CONTRACT 4.10) + SLOT phase (4.11) ----------
      sS0 : Int;                                // ship containers at plan time
      sY0 : Int;                                // yard containers at plan time
      SlBalL : Int;                             // ship halves at plan time (x 0..1 / 2..3, y 0..5 / 6..11)
      SlBalR : Int;
      SlBalF : Int;
      SlBalA : Int;
      FtNu : Int;                               // pending unloads (sources 1..FtNu, list order)
      FtNl : Int;                               // pending loads (sources FtNu+1..nSrc, list order)
      FtRow : Int;                              // table row (unloads done) built next: FtNu..0
      FtActive : Bool;                          // building FtMask (one row per call)
      FtUse : Bool;                             // greedy Pass A uses FtMask (order mode 1 / 2)
      OrderOk : Bool;                           // FtMask[0,0] contains the start state (order 0: TRUE)
      FtMask : Array[0..48, 0..48] of DWord;    // bit L: state (i unloads, j loads done, L left) completable
      FaTot : Array[0..96] of Int;              // IMPROVE replay: ship containers after step k
      FaYc : Array[0..96] of Int;               // IMPROVE replay: yard containers after step k
      FaMask : Array[0..96] of DWord;           // IMPROVE replay: bit L: steps k+1..n completable from L
      cSlotSweeps : Int;                        // World.CfgSlotSweeps (0 = no SLOT phase)
      SlStart : Bool;                           // SLOT phase to be initialised
      SlActive : Bool;                          // SLOT phase running (one step k per call)
      FinStart : Bool;                          // finalise: cumulative T/M, copy to BestPlan, publish
      SlK : Int;                                // SLOT: step processed next
      SlSweep : Int;                            // SLOT: current sweep 1..cSlotSweeps
      SlImp : Bool;                             // SLOT: an improvement was accepted in this sweep
      SlAcc : DInt;                             // SLOT: accepted changes
      SlAvail : Array[0..1, 0..3, 0..11] of Int; // first step that may drop into the cell (999 never)
      SlUsed : Array[0..1, 0..3, 0..11] of Int;  // step whose drop uses the cell (0 none)
   END_VAR
   VAR_TEMP
      rcode : Int;
      i : Int;
      j : Int;
      k : Int;
      x : Int;
      y : Int;
      b : Int;
      ie : Int;
      si : Int;
      sj : Int;
      id : UInt;
      found : Bool;
      okB : Bool;
      edgeCall : Bool;
      budget : Int;
      rtDummy : LReal;
      tmpT : DInt;
      tmpM : Int;
      wv : DInt;
      dGi : Int;
      dYi : Int;
      xd : Int;
      // step
      L : Int;
      R : Int;
      F : Int;
      A : Int;
      L2 : Int;
      R2 : Int;
      F2 : Int;
      A2 : Int;
      dAbs : Int;
      uLt : Int;
      uRt : Int;
      nLt : Int;
      uL : Int;
      uR : Int;
      nL : Int;
      Lbase : Int;
      Rbase : Int;
      loN : Int;
      hiN : Int;
      Dbase : Int;
      fU : Int;
      fU2 : Int;
      fL : Int;
      fL2 : Int;
      nxU : Int;
      nxL : Int;
      nx1 : Int;
      nx2 : Int;
      iPas : Int;
      sCol : Int;
      sRow : Int;
      sBay : Int;
      srcCol : Int;
      dBay : Int;
      dCol : Int;
      dRow : Int;
      dGc : Int;
      Ew : DInt;
      Lm : DInt;
      Nx : DInt;
      nxFirst : Bool;
      score : DInt;
      bestScore : DInt;
      bS : Int;
      bK : Int;
      bDb : Int;
      eT : DInt;
      eMan : Int;
      lT : DInt;
      lMan : Int;
      kv : DInt;
      // v1.3 improve phase / lower bound (prefix q: avoid the TIA temp-name pitfalls)
      qEv : Int;
      qScan : Int;
      qMv : Int;
      qI : Int;
      qJ : Int;
      qImax : Int;
      qHave : Bool;
      qEnd : Bool;
      qValid : Bool;
      qFail : Bool;
      qFin : Bool;
      qKa : USInt;
      qKb : USInt;
      qLow : Int;
      qHigh : Int;
      qQ : Int;
      qRd : Int;
      qU : Int;                                 // v1.5 pattern relocate: next unload / load read position
      qL : Int;
      qPos : Int;
      qStart : Int;
      qStep : Int;
      qNx : Int;
      qW : DInt;
      qNu : Int;
      qNl : Int;
      qXs : DInt;
      qKind : Int;
      qVal : Int;
      qFv : Int;
      qFm : Int;
      qHaveF : Bool;
      qSf : Int;
      qXt : DInt;
      qXb : DInt;
      qAtSrc : Bool;
      // v1.4 (prefix w)
      wTot : Int;
      wYc : Int;
      wLv : Int;
      wRv : Int;
      wSd : Int;
      wOk : Bool;
      wMsk : DWord;
      wC : Int;
      wQ : Int;
      wNq : Int;
      wOx : Int;
      wOy : Int;
      wGo : Bool;
      wChk : Bool;
      wTrj : Bool;
      wCur : DInt;
      wC1 : DInt;
      wC2 : DInt;
      wLa : Int;
      wRa : Int;
      wFa : Int;
      wAa : Int;
   END_VAR


BEGIN
	REGION 1 Request edge / abort
	    #edgeCall := FALSE;
	    IF #Req AND NOT #ReqOld THEN
	        // ---------- new job: snapshot ----------
	        #edgeCall := TRUE;
	        #JobBusy := TRUE;
	        #Done := FALSE;
	        #Error := FALSE;
	        #ErrCode := 0;
	        #VarNo := 1;
	        #VarActive := FALSE;
	        #VarErr := 0;
	        #Err1 := 0;
	        #HaveBest := FALSE;
	        #BestV := 0;
	        #BestK := 0;
	        #BestLen := 0;
	        #DiagCalls := 1;
	        #DiagSteps := 0;
	        #DiagCallMs := 0.0;
	        #DiagMaxCallMs := 0.0;
	        #DiagJobMs := 0.0;
	        FOR #i := 1 TO 4 DO
	            #DiagVarK[#i] := -1;
	            #DiagVarErr[#i] := 0;
	        END_FOR;
	        #rcode := 0;

	        // configuration
	        #cMMode := USINT_TO_INT("World".CfgMMode);
	        #cOrder := USINT_TO_INT("World".CfgOrderMode);
	        #cBalMode := USINT_TO_INT("World".CfgBalMode);
	        #cLim := "World".CfgBalLimit;
	        #cCeil := 0;                            // v1.5: relaxed rule only with BalCeil > limit
	        IF "World".BalCeil > #cLim THEN
	            #cCeil := "World".BalCeil;
	        END_IF;
	        #cVariants := "World".CfgVariants;
	        #cSteps := "World".CfgStepsPerCall;
	        IF #cSteps < 1 THEN
	            #cSteps := 1;
	        END_IF;
	        FOR #i := 1 TO 4 DO
	            #cAlpha[#i] := INT_TO_DINT("World".CfgAlpha[#i]);
	        END_FOR;
	        #sCx := SINT_TO_INT("World".CraneX);
	        #sCy := SINT_TO_INT("World".CraneY);
	        #sCb := USINT_TO_INT("World".CraneBay);
	        #sBaseT := "World".BaseT_ds;
	        #sBaseM := "World".BaseM;
	        #sN := "World".N;
	        // v1.3 improve phase configuration
	        #cImpEvals := "World".CfgImproveEvals;
	        IF #cImpEvals < 0 THEN
	            #cImpEvals := 0;
	        END_IF;
	        #cImpDist := "World".CfgImproveDist;
	        #cImpPerCall := "World".CfgImprovePerCall;
	        IF #cImpPerCall < 1 THEN
	            #cImpPerCall := 1;
	        END_IF;
	        #PubPending := FALSE;
	        #ImpActive := FALSE;
	        #ImpEvals := 0;
	        #ImpAcc := 0;
	        #LbT := 0;
	        #LbM := 0;
	        // v1.4 exact order feasibility + SLOT phase
	        #FtActive := FALSE;
	        #FtUse := FALSE;
	        #OrderOk := FALSE;
	        #SlStart := FALSE;
	        #SlActive := FALSE;
	        #FinStart := FALSE;
	        #SlAcc := 0;
	        #cSlotSweeps := "World".CfgSlotSweeps;
	        IF #cSlotSweeps < 0 THEN
	            #cSlotSweeps := 0;
	        END_IF;

	        IF "World".Carried <> 0 THEN
	            #rcode := 4;
	        ELSIF #cVariants < 1 OR #cVariants > 4 OR #cOrder > 2 OR #cBalMode > 1 OR #cMMode > 2 THEN
	            #rcode := 3;
	        ELSIF #sCx < 0 OR #sCx > 3 OR #sCy < 0 OR #sCy > 11 OR #sCb < 0 OR #sCb > 1 THEN
	            #rcode := 3;
	        END_IF;

	        IF #rcode = 0 THEN
	            // grids
	            FOR #x := 0 TO 3 DO
	                FOR #y := 0 TO 11 DO
	                    #sG[0, #x, #y] := "World".Bay0[#x, #y];
	                    #sG[1, #x, #y] := "World".Bay1[#x, #y];
	                END_FOR;
	            END_FOR;
	            // pending sources: unloads (UState = 0) in index order, then loads (LState = 0).
	            // Each is located in its bay by the first match, x 0..3 outer, y 0..11 inner.
	            #nSrc := 0;
	            FOR #k := 1 TO 2 DO
	                FOR #i := 1 TO 48 DO
	                    IF #rcode = 0 THEN
	                        IF #k = 1 THEN
	                            #okB := "World".UState[#i] = 0;
	                            #id := "World".UList[#i];
	                            #b := 0;
	                        ELSE
	                            #okB := "World".LState[#i] = 0;
	                            #id := "World".LList[#i];
	                            #b := 1;
	                        END_IF;
	                        IF #okB THEN
	                            IF #id = 0 THEN
	                                #rcode := 3;           // pending entry without an ID
	                            ELSE
	                                #found := FALSE;
	                                FOR #x := 0 TO 3 DO
	                                    FOR #y := 0 TO 11 DO
	                                        IF NOT #found AND #sG[#b, #x, #y] = #id THEN
	                                            #found := TRUE;
	                                            #nSrc := #nSrc + 1;
	                                            #SrcKind[#nSrc] := INT_TO_USINT(#k);
	                                            #SrcIdx[#nSrc] := #i;
	                                            #SrcId[#nSrc] := #id;
	                                            #SrcX[#nSrc] := #x;
	                                            #SrcY[#nSrc] := #y;
	                                            #SrcB[#nSrc] := #b;
	                                            IF #b = 0 THEN
	                                                #SrcG[#nSrc] := #x + 6;
	                                            ELSE
	                                                #SrcG[#nSrc] := #x;
	                                            END_IF;
	                                        END_IF;
	                                    END_FOR;
	                                END_FOR;
	                                IF NOT #found THEN
	                                    #rcode := 3;       // pending ID not in its bay (CONTRACT ambiguity, Python: 3)
	                                END_IF;
	                            END_IF;
	                        END_IF;
	                    END_IF;
	                END_FOR;
	            END_FOR;
	        END_IF;

	        IF #rcode = 0 THEN
	            // weighted cost table from FC20. From (0,0,bay 1) to (dG,dy,bay 1): global column
	            // difference dG, x changed iff dG <> 0. x unchanged with dG <> 0 only happens for a
	            // bay change in the same column (dG = 6): from (0,0,1) to (0,dy,0).
	            FOR #i := 0 TO 9 DO
	                FOR #j := 0 TO 11 DO
	                    #tmpT := "Crane_MoveCost"(X0 := 0, Y0 := 0, B0 := 1, X1 := #i, Y1 := #j, B1 := 1,
	                                              MMode := #cMMode, M => #tmpM);
	                    #wv := #tmpT + 190 * INT_TO_DINT(#tmpM);
	                    #WTab[#i, #j, 0] := #wv;
	                    #WTab[#i, #j, 1] := #wv;
	                END_FOR;
	            END_FOR;
	            FOR #j := 0 TO 11 DO
	                #tmpT := "Crane_MoveCost"(X0 := 0, Y0 := 0, B0 := 1, X1 := 0, Y1 := #j, B1 := 0,
	                                          MMode := #cMMode, M => #tmpM);
	                #WTab[6, #j, 0] := #tmpT + 190 * INT_TO_DINT(#tmpM);
	            END_FOR;

	            // ---------- closed-form lower bound of the pending work (CONTRACT 4.9) ----------
	            // X = 2*sum(x of unloads) + 2*sum(3 - x of loads) + 3P + 3S + F (columns);
	            // T_LB = 400 P + 60 X_min [ds], M_LB = 4P - [a pending source at the crane position].
	            IF #nSrc > 0 THEN
	                #qNu := 0;
	                #qNl := 0;
	                #qXs := 3 * INT_TO_DINT(#nSrc);
	                #qAtSrc := FALSE;
	                FOR #i := 1 TO #nSrc DO
	                    IF #SrcKind[#i] = 1 THEN
	                        #qNu := #qNu + 1;
	                        #qXs := #qXs + 2 * INT_TO_DINT(#SrcX[#i]);
	                    ELSE
	                        #qNl := #qNl + 1;
	                        #qXs := #qXs + 2 * INT_TO_DINT(3 - #SrcX[#i]);
	                    END_IF;
	                    IF #SrcX[#i] = #sCx AND #SrcY[#i] = #sCy AND #SrcB[#i] = #sCb THEN
	                        #qAtSrc := TRUE;
	                    END_IF;
	                END_FOR;
	                IF #sCb = 0 THEN
	                    #cG := #sCx + 6;
	                ELSE
	                    #cG := #sCx;
	                END_IF;
	                #qXb := -1;
	                FOR #qKind := 1 TO 2 DO
	                    #qHaveF := FALSE;
	                    #qFm := 0;
	                    FOR #i := 1 TO #nSrc DO
	                        IF USINT_TO_INT(#SrcKind[#i]) = #qKind THEN
	                            IF #qKind = 1 THEN
	                                #qVal := #SrcX[#i] + 3;
	                            ELSE
	                                #qVal := 6 - #SrcX[#i];
	                            END_IF;
	                            #qFv := 3 + ABS(#cG - #SrcG[#i]) - #qVal;
	                            IF NOT #qHaveF OR #qFv < #qFm THEN
	                                #qFm := #qFv;
	                                #qHaveF := TRUE;
	                            END_IF;
	                        END_IF;
	                    END_FOR;
	                    IF #qHaveF THEN
	                        IF #qKind = 2 THEN
	                            IF #qNu > #qNl THEN
	                                #qSf := #qNu - #qNl;
	                            ELSE
	                                #qSf := MAX(IN1 := 0, IN2 := #qNl - #qNu - 1);
	                            END_IF;
	                        ELSE
	                            IF #qNu >= #qNl THEN
	                                #qSf := MAX(IN1 := 0, IN2 := #qNu - #qNl - 1);
	                            ELSE
	                                #qSf := #qNl - #qNu;
	                            END_IF;
	                        END_IF;
	                        #qXt := #qXs + 3 * INT_TO_DINT(#qSf) + INT_TO_DINT(#qFm);
	                        IF #qXb < 0 OR #qXt < #qXb THEN
	                            #qXb := #qXt;
	                        END_IF;
	                    END_IF;
	                END_FOR;
	                #LbT := 400 * INT_TO_DINT(#nSrc) + 60 * #qXb;
	                #LbM := 4 * INT_TO_DINT(#nSrc);
	                IF #qAtSrc THEN
	                    #LbM := #LbM - 1;
	                END_IF;
	            END_IF;
	        END_IF;

	        IF #rcode = 0 THEN
	            // ---------- v1.4: counts for the order feasibility table (4.10) and the SLOT phase (4.11) ----------
	            #sS0 := 0;
	            #sY0 := 0;
	            #SlBalL := 0;
	            #SlBalR := 0;
	            #SlBalF := 0;
	            #SlBalA := 0;
	            FOR #x := 0 TO 3 DO
	                FOR #y := 0 TO 11 DO
	                    IF #sG[0, #x, #y] <> 0 THEN
	                        #sS0 := #sS0 + 1;
	                        IF #x <= 1 THEN
	                            #SlBalL := #SlBalL + 1;
	                        ELSE
	                            #SlBalR := #SlBalR + 1;
	                        END_IF;
	                        IF #y <= 5 THEN
	                            #SlBalF := #SlBalF + 1;
	                        ELSE
	                            #SlBalA := #SlBalA + 1;
	                        END_IF;
	                    END_IF;
	                    IF #sG[1, #x, #y] <> 0 THEN
	                        #sY0 := #sY0 + 1;
	                    END_IF;
	                END_FOR;
	            END_FOR;
	            #FtNu := 0;
	            FOR #i := 1 TO #nSrc DO
	                IF #SrcKind[#i] = 1 THEN
	                    #FtNu := #FtNu + 1;
	                END_IF;
	            END_FOR;
	            #FtNl := #nSrc - #FtNu;
	            #FtUse := #cOrder <> 0;
	            #FtActive := #FtUse;               // order 1 / 2: build FtMask first (rows FtNu..0, one per call)
	            #FtRow := #FtNu;
	            #OrderOk := NOT #FtUse;
	        END_IF;

	        IF #rcode <> 0 THEN
	            "World".PlanValid := FALSE;
	            "World".PlanLen := 0;
	            "World".PlanVariant := 0;
	            "World".OrderFeasible := FALSE;
	            "World".SlotAccepts := 0;
	            #JobBusy := FALSE;
	            #Error := TRUE;
	            #ErrCode := #rcode;
	        END_IF;
	    ELSIF NOT #Req THEN
	        // Req low: clear the result flags; a running job is abandoned without writing "World".
	        #JobBusy := FALSE;
	        #Done := FALSE;
	        #Error := FALSE;
	        #VarActive := FALSE;
	    END_IF;
	    #ReqOld := #Req;
	END_REGION

	REGION 2 Work: greedy steps, variants, result
	    IF #JobBusy AND NOT #edgeCall THEN
	        #rtDummy := RUNTIME(MEM := #RtMem);
	        #DiagCalls := #DiagCalls + 1;
	        #budget := #cSteps;
	        WHILE #JobBusy AND #budget > 0 DO
	            IF #FtActive THEN
	                // ================= v1.4: exact order feasibility table (CONTRACT 4.10) =================
	                // FtMask[i, j] bit L = from "i pending unloads done (list prefix), j pending loads done,
	                // L containers in x 0..1" (R = sS0 - i + j - L) all remaining transfers can still be done
	                // under the step rule and the capacities. Unload sides are fixed, a load may go left or
	                // right; order 2 allows loads only after all unloads. One row i per call (<= 49 x 25 x 3).
	                #budget := 0;
	                #i := #FtRow;
	                FOR #j := #FtNl TO 0 BY -1 DO
	                    #wTot := #sS0 - #i + #j;
	                    #wMsk := DWORD#16#0;
	                    FOR #wLv := 0 TO 24 DO
	                        #wRv := #wTot - #wLv;
	                        IF #wRv >= 0 AND #wRv <= 24 THEN
	                            IF #i = #FtNu AND #j = #FtNl THEN
	                                #wOk := #cCeil = 0 OR ABS(#wLv - #wRv) <= #cLim;   // v1.5: relaxed -> end balanced
	                            ELSE
	                                #wOk := FALSE;
	                                IF #i < #FtNu AND #sY0 + #i - #j < 48 THEN
	                                    IF #SrcX[#i + 1] <= 1 THEN
	                                        #L2 := #wLv - 1;
	                                        #R2 := #wRv;
	                                    ELSE
	                                        #L2 := #wLv;
	                                        #R2 := #wRv - 1;
	                                    END_IF;
	                                    IF #L2 >= 0 AND #R2 >= 0 THEN
	                                        #dAbs := ABS(#L2 - #R2);
	                                        IF #dAbs <= #cLim OR #dAbs <= ABS(#wLv - #wRv) OR (ABS(#wLv - #wRv) > #cLim AND #dAbs <= #cCeil) THEN
	                                            #wOk := (#FtMask[#i + 1, #j] AND SHL(IN := DWORD#16#1, N := INT_TO_USINT(#L2))) <> DWORD#16#0;
	                                        END_IF;
	                                    END_IF;
	                                END_IF;
	                                IF NOT #wOk AND #j < #FtNl AND (#cOrder = 1 OR #i = #FtNu) THEN
	                                    FOR #wSd := 0 TO 1 DO
	                                        IF #wSd = 0 THEN
	                                            #L2 := #wLv + 1;
	                                            #R2 := #wRv;
	                                        ELSE
	                                            #L2 := #wLv;
	                                            #R2 := #wRv + 1;
	                                        END_IF;
	                                        IF NOT #wOk AND #L2 <= 24 AND #R2 <= 24 THEN
	                                            #dAbs := ABS(#L2 - #R2);
	                                            IF #dAbs <= #cLim OR #dAbs <= ABS(#wLv - #wRv) OR (ABS(#wLv - #wRv) > #cLim AND #dAbs <= #cCeil) THEN
	                                                #wOk := (#FtMask[#i, #j + 1] AND SHL(IN := DWORD#16#1, N := INT_TO_USINT(#L2))) <> DWORD#16#0;
	                                            END_IF;
	                                        END_IF;
	                                    END_FOR;
	                                END_IF;
	                            END_IF;
	                            IF #wOk THEN
	                                #wMsk := #wMsk OR SHL(IN := DWORD#16#1, N := INT_TO_USINT(#wLv));
	                            END_IF;
	                        END_IF;
	                    END_FOR;
	                    #FtMask[#i, #j] := #wMsk;
	                END_FOR;
	                #FtRow := #FtRow - 1;
	                IF #FtRow < 0 THEN
	                    #FtActive := FALSE;
	                    #OrderOk := (#FtMask[0, 0] AND SHL(IN := DWORD#16#1, N := INT_TO_USINT(#SlBalL))) <> DWORD#16#0;
	                    IF #cCeil > 0 AND NOT #OrderOk THEN
	                        // v1.5 (R2-J1): the relaxed rule is only used when the list order is exactly
	                        // feasible under it; else ErrCode 1 -> FB10 continues its fallback chain
	                        "World".PlanValid := FALSE;
	                        "World".PlanLen := 0;
	                        "World".PlanVariant := 0;
	                        "World".SlotAccepts := 0;
	                        "World".OrderFeasible := FALSE;
	                        #JobBusy := FALSE;
	                        #Error := TRUE;
	                        #ErrCode := 1;
	                    END_IF;
	                END_IF;

	            ELSIF #ImpActive THEN
	                // ================= IMPROVE phase (CONTRACT 4.8) =================
	                // Up to cImpPerCall evaluations per call (each = one replay); scan guard bounds the
	                // number of iterator positions per call. The result does not depend on the split.
	                #budget := 0;
	                #qEv := 0;
	                #qScan := 0;
	                WHILE #ImpActive AND #qEv < #cImpPerCall AND #qScan < 3000 DO
	                    #qScan := #qScan + 1;
	                    // ---- current iterator position, then advance ----
	                    #qMv := #ItMv;
	                    #qI := #ItI;
	                    #qJ := #ItJ;
	                    #qEnd := FALSE;
	                    IF #ItMv = 0 THEN
	                        #qHave := TRUE;                 // move 0: re-slot the incumbent (p = 1)
	                        #ItMv := 1;
	                        #ItI := 1;
	                        #ItJ := 1;
	                    ELSE
	                        IF #ItMv = 3 THEN
	                            #qImax := #LsN - 1;
	                        ELSE
	                            #qImax := #LsN;
	                        END_IF;
	                        #qHave := #ItJ <> #ItI AND (#ItMv <> 2 OR #ItJ > #ItI)
	                                  AND (#cImpDist <= 0 OR ABS(#ItI - #ItJ) <= #cImpDist);
	                        #ItJ := #ItJ + 1;
	                        IF #ItJ > #qImax THEN
	                            #ItJ := 1;
	                            #ItI := #ItI + 1;
	                            IF #ItI > #qImax THEN
	                                #ItI := 1;
	                                #ItMv := #ItMv + 1;
	                                IF #ItMv > 3 THEN
	                                    #ItMv := 1;
	                                    #qEnd := TRUE;      // end of a sweep (moves 1..3)
	                                END_IF;
	                            END_IF;
	                        END_IF;
	                    END_IF;

	                    // ---- order-mode validity (mode 1: no element passes one of the same list) ----
	                    #qValid := #qHave;
	                    IF #qHave AND #cOrder = 1 AND #qMv <> 0 THEN
	                        IF #qMv = 1 THEN
	                            // v1.5 (judge round 2 R2-SCORE-1): move 1 = relocate the KIND TOKEN at i to j
	                            // (U/L pattern), the k-th U / L stays the k-th unload / load. Valid iff an
	                            // element of the other kind lies between i and j (else the pattern is unchanged).
	                            #qKa := #SrcKind[#LsSeq[#qI]];
	                            IF #qI < #qJ THEN
	                                #qLow := #qI + 1;
	                                #qHigh := #qJ;
	                            ELSE
	                                #qLow := #qJ;
	                                #qHigh := #qI - 1;
	                            END_IF;
	                            #qValid := FALSE;
	                            FOR #qQ := #qLow TO #qHigh DO
	                                IF #SrcKind[#LsSeq[#qQ]] <> #qKa THEN
	                                    #qValid := TRUE;
	                                    EXIT;
	                                END_IF;
	                            END_FOR;
	                        ELSIF #qMv = 2 THEN
	                            #qValid := #qJ = #qI + 1 AND #SrcKind[#LsSeq[#qI]] <> #SrcKind[#LsSeq[#qJ]];
	                        ELSE
	                            #qKa := #SrcKind[#LsSeq[#qI]];
	                            #qKb := #SrcKind[#LsSeq[#qI + 1]];
	                            IF #qJ < #qI THEN
	                                #qLow := #qJ;
	                                #qHigh := #qI - 1;
	                            ELSE
	                                #qLow := #qI + 2;
	                                #qHigh := #qJ + 1;
	                            END_IF;
	                            FOR #qQ := #qLow TO #qHigh DO
	                                IF #SrcKind[#LsSeq[#qQ]] = #qKa OR #SrcKind[#LsSeq[#qQ]] = #qKb THEN
	                                    #qValid := FALSE;
	                                    EXIT;
	                                END_IF;
	                            END_FOR;
	                        END_IF;
	                    END_IF;

	                    IF #qValid THEN
	                        // ---- build the candidate sequence CdSeq and its first changed position ----
	                        IF #qMv = 0 OR #qMv = 2 THEN
	                            FOR #qQ := 1 TO #LsN DO
	                                #CdSeq[#qQ] := #LsSeq[#qQ];
	                            END_FOR;
	                            IF #qMv = 2 THEN
	                                #CdSeq[#qI] := #LsSeq[#qJ];
	                                #CdSeq[#qJ] := #LsSeq[#qI];
	                            END_IF;
	                        ELSIF #qMv = 1 AND #cOrder = 1 THEN
	                            // v1.5 pattern relocate: kind of position q in the new pattern (token i moved
	                            // to j), then the next not yet used element of that kind
	                            #qKa := #SrcKind[#LsSeq[#qI]];
	                            #qRd := 1;
	                            #qU := 1;
	                            #qL := 1;
	                            FOR #qQ := 1 TO #LsN DO
	                                IF #qQ = #qJ THEN
	                                    #qKb := #qKa;
	                                ELSE
	                                    IF #qRd = #qI THEN
	                                        #qRd := #qRd + 1;
	                                    END_IF;
	                                    #qKb := #SrcKind[#LsSeq[#qRd]];
	                                    #qRd := #qRd + 1;
	                                END_IF;
	                                IF #qKb = #qKa THEN
	                                    WHILE #SrcKind[#LsSeq[#qU]] <> #qKa DO
	                                        #qU := #qU + 1;
	                                    END_WHILE;
	                                    #CdSeq[#qQ] := #LsSeq[#qU];
	                                    #qU := #qU + 1;
	                                ELSE
	                                    WHILE #SrcKind[#LsSeq[#qL]] = #qKa DO
	                                        #qL := #qL + 1;
	                                    END_WHILE;
	                                    #CdSeq[#qQ] := #LsSeq[#qL];
	                                    #qL := #qL + 1;
	                                END_IF;
	                            END_FOR;
	                        ELSE
	                            // move 1: element i to position j; move 3: pair (i, i+1) to j, j+1;
	                            // all other positions keep the remaining elements in order
	                            #qRd := 1;
	                            FOR #qQ := 1 TO #LsN DO
	                                IF #qQ = #qJ THEN
	                                    #CdSeq[#qQ] := #LsSeq[#qI];
	                                ELSIF #qMv = 3 AND #qQ = #qJ + 1 THEN
	                                    #CdSeq[#qQ] := #LsSeq[#qI + 1];
	                                ELSE
	                                    IF #qRd = #qI THEN
	                                        IF #qMv = 3 THEN
	                                            #qRd := #qRd + 2;
	                                        ELSE
	                                            #qRd := #qRd + 1;
	                                        END_IF;
	                                    END_IF;
	                                    #CdSeq[#qQ] := #LsSeq[#qRd];
	                                    #qRd := #qRd + 1;
	                                END_IF;
	                            END_FOR;
	                        END_IF;
	                        IF #qMv = 0 THEN
	                            #qPos := 1;
	                        ELSIF #qMv = 1 AND #cOrder = 1 THEN
	                            #qPos := 1;                 // first changed position (exists: pattern changed)
	                            WHILE #qPos < #LsN AND #CdSeq[#qPos] = #LsSeq[#qPos] DO
	                                #qPos := #qPos + 1;
	                            END_WHILE;
	                        ELSIF #qI < #qJ THEN
	                            #qPos := #qI;
	                        ELSE
	                            #qPos := #qJ;
	                        END_IF;

	                        // ---- replay from qStart = max(1, p-1) on the incumbent's cached prefix ----
	                        #qStart := #qPos - 1;
	                        IF #qStart < 1 THEN
	                            #qStart := 1;
	                        END_IF;
	                        FOR #b := 0 TO 1 DO
	                            FOR #x := 0 TO 3 DO
	                                FOR #y := 0 TO 11 DO
	                                    #g[#b, #x, #y] := #sG[#b, #x, #y];
	                                END_FOR;
	                            END_FOR;
	                        END_FOR;
	                        FOR #qQ := 1 TO #qStart - 1 DO
	                            #si := #LsSeq[#qQ];
	                            #g[#LsDB[#qQ], #LsDX[#qQ], #LsDY[#qQ]] := #SrcId[#si];
	                            #g[#SrcB[#si], #SrcX[#si], #SrcY[#si]] := 0;
	                        END_FOR;
	                        IF #qStart > 1 THEN
	                            #cx := #LsDX[#qStart - 1];
	                            #cy := #LsDY[#qStart - 1];
	                            #cb := #LsDB[#qStart - 1];
	                        ELSE
	                            #cx := #sCx;
	                            #cy := #sCy;
	                            #cb := #sCb;
	                        END_IF;
	                        #TotT := #LsT[#qStart - 1];
	                        #TotM := #LsM[#qStart - 1];
	                        #L := 0;
	                        #R := 0;
	                        #F := 0;
	                        #A := 0;
	                        FOR #x := 0 TO 3 DO
	                            FOR #y := 0 TO 11 DO
	                                IF #g[0, #x, #y] <> 0 THEN
	                                    IF #x <= 1 THEN
	                                        #L := #L + 1;
	                                    ELSE
	                                        #R := #R + 1;
	                                    END_IF;
	                                    IF #y <= 5 THEN
	                                        #F := #F + 1;
	                                    ELSE
	                                        #A := #A + 1;
	                                    END_IF;
	                                END_IF;
	                            END_FOR;
	                        END_FOR;
	                        #uLt := 0;
	                        #uRt := 0;
	                        #nLt := 0;
	                        FOR #qQ := #qStart TO #LsN DO
	                            #si := #CdSeq[#qQ];
	                            IF #SrcKind[#si] = 1 THEN
	                                IF #SrcX[#si] <= 1 THEN
	                                    #uLt := #uLt + 1;
	                                ELSE
	                                    #uRt := #uRt + 1;
	                                END_IF;
	                            ELSE
	                                #nLt := #nLt + 1;
	                            END_IF;
	                        END_FOR;

	                        // ---- v1.4: exact side feasibility of the remaining fixed sequence (CONTRACT 4.10) ----
	                        // FaMask[k] bit L = after step k with L containers in x 0..1, steps k+1..LsN can
	                        // be done (unload sides fixed, loads either side, step rule, capacities).
	                        #wYc := 0;
	                        FOR #x := 0 TO 3 DO
	                            FOR #y := 0 TO 11 DO
	                                IF #g[1, #x, #y] <> 0 THEN
	                                    #wYc := #wYc + 1;
	                                END_IF;
	                            END_FOR;
	                        END_FOR;
	                        #FaTot[#qStart - 1] := #L + #R;
	                        #FaYc[#qStart - 1] := #wYc;
	                        FOR #qQ := #qStart TO #LsN DO
	                            IF #SrcKind[#CdSeq[#qQ]] = 1 THEN
	                                #FaTot[#qQ] := #FaTot[#qQ - 1] - 1;
	                                #FaYc[#qQ] := #FaYc[#qQ - 1] + 1;
	                            ELSE
	                                #FaTot[#qQ] := #FaTot[#qQ - 1] + 1;
	                                #FaYc[#qQ] := #FaYc[#qQ - 1] - 1;
	                            END_IF;
	                        END_FOR;
	                        #wMsk := DWORD#16#0;
	                        FOR #wLv := 0 TO 24 DO
	                            #wRv := #FaTot[#LsN] - #wLv;
	                            IF #wRv >= 0 AND #wRv <= 24 AND (#cCeil = 0 OR ABS(#wLv - #wRv) <= #cLim) THEN
	                                #wMsk := #wMsk OR SHL(IN := DWORD#16#1, N := INT_TO_USINT(#wLv));
	                            END_IF;
	                        END_FOR;
	                        #FaMask[#LsN] := #wMsk;
	                        FOR #qQ := #LsN TO #qStart BY -1 DO
	                            #si := #CdSeq[#qQ];
	                            #wTot := #FaTot[#qQ - 1];
	                            #wMsk := DWORD#16#0;
	                            FOR #wLv := 0 TO 24 DO
	                                #wRv := #wTot - #wLv;
	                                IF #wRv >= 0 AND #wRv <= 24 THEN
	                                    #wOk := FALSE;
	                                    IF #SrcKind[#si] = 1 THEN
	                                        IF #FaYc[#qQ - 1] < 48 THEN
	                                            IF #SrcX[#si] <= 1 THEN
	                                                #L2 := #wLv - 1;
	                                                #R2 := #wRv;
	                                            ELSE
	                                                #L2 := #wLv;
	                                                #R2 := #wRv - 1;
	                                            END_IF;
	                                            IF #L2 >= 0 AND #R2 >= 0 THEN
	                                                #dAbs := ABS(#L2 - #R2);
	                                                IF #dAbs <= #cLim OR #dAbs <= ABS(#wLv - #wRv) OR (ABS(#wLv - #wRv) > #cLim AND #dAbs <= #cCeil) THEN
	                                                    #wOk := (#FaMask[#qQ] AND SHL(IN := DWORD#16#1, N := INT_TO_USINT(#L2))) <> DWORD#16#0;
	                                                END_IF;
	                                            END_IF;
	                                        END_IF;
	                                    ELSE
	                                        FOR #wSd := 0 TO 1 DO
	                                            IF #wSd = 0 THEN
	                                                #L2 := #wLv + 1;
	                                                #R2 := #wRv;
	                                            ELSE
	                                                #L2 := #wLv;
	                                                #R2 := #wRv + 1;
	                                            END_IF;
	                                            IF NOT #wOk AND #L2 <= 24 AND #R2 <= 24 THEN
	                                                #dAbs := ABS(#L2 - #R2);
	                                                IF #dAbs <= #cLim OR #dAbs <= ABS(#wLv - #wRv) OR (ABS(#wLv - #wRv) > #cLim AND #dAbs <= #cCeil) THEN
	                                                    #wOk := (#FaMask[#qQ] AND SHL(IN := DWORD#16#1, N := INT_TO_USINT(#L2))) <> DWORD#16#0;
	                                                END_IF;
	                                            END_IF;
	                                        END_FOR;
	                                    END_IF;
	                                    IF #wOk THEN
	                                        #wMsk := #wMsk OR SHL(IN := DWORD#16#1, N := INT_TO_USINT(#wLv));
	                                    END_IF;
	                                END_IF;
	                            END_FOR;
	                            #FaMask[#qQ - 1] := #wMsk;
	                        END_FOR;
	                        // no side assignment completes the candidate: rejected without a replay
	                        #qFail := (#FaMask[#qStart - 1] AND SHL(IN := DWORD#16#1, N := INT_TO_USINT(#L))) = DWORD#16#0;
	                        IF NOT #qFail THEN
	                        FOR #qStep := #qStart TO #LsN DO
	                            #si := #CdSeq[#qStep];
	                            #sCol := #SrcX[#si];
	                            #sRow := #SrcY[#si];
	                            #sBay := #SrcB[#si];
	                            #srcCol := #SrcG[#si];
	                            #dBay := 1 - #sBay;
	                            IF #qStep < #LsN THEN
	                                #qNx := #CdSeq[#qStep + 1];
	                            ELSE
	                                #qNx := 0;
	                            END_IF;
	                            // empty move to the source (not issued when the crane is already there)
	                            IF #cx <> #sCol OR #cy <> #sRow OR #cb <> #sBay THEN
	                                #eT := "Crane_MoveCost"(X0 := #cx, Y0 := #cy, B0 := #cb, X1 := #sCol, Y1 := #sRow, B1 := #sBay,
	                                                        MMode := #cMMode, M => #eMan);
	                                #TotT := #TotT + #eT;
	                                #TotM := #TotM + INT_TO_DINT(#eMan);
	                            END_IF;
	                            // remaining work after this step (for reachability)
	                            IF #SrcKind[#si] = 1 THEN
	                                IF #sCol <= 1 THEN
	                                    #uLt := #uLt - 1;
	                                ELSE
	                                    #uRt := #uRt - 1;
	                                END_IF;
	                                IF #sCol <= 1 THEN
	                                    #L2 := #L - 1;
	                                    #R2 := #R;
	                                ELSE
	                                    #L2 := #L;
	                                    #R2 := #R - 1;
	                                END_IF;
	                                IF #sRow <= 5 THEN
	                                    #F2 := #F - 1;
	                                    #A2 := #A;
	                                ELSE
	                                    #F2 := #F;
	                                    #A2 := #A - 1;
	                                END_IF;
	                            ELSE
	                                #nLt := #nLt - 1;
	                            END_IF;
	                            // slot rule: min W(s->d) + W(d->next source); Pass A (step rule + reachability), else Pass B
	                            #found := FALSE;
	                            #bestScore := 0;
	                            #bK := 0;
	                            #bDb := 0;
	                            FOR #iPas := 0 TO 1 DO
	                                FOR #x := 0 TO 3 DO
	                                    FOR #y := 0 TO 11 DO
	                                        IF #g[#dBay, #x, #y] = 0 THEN
	                                            IF #SrcKind[#si] = 2 THEN
	                                                IF #x <= 1 THEN
	                                                    #L2 := #L + 1;
	                                                    #R2 := #R;
	                                                ELSE
	                                                    #L2 := #L;
	                                                    #R2 := #R + 1;
	                                                END_IF;
	                                                IF #y <= 5 THEN
	                                                    #F2 := #F + 1;
	                                                    #A2 := #A;
	                                                ELSE
	                                                    #F2 := #F;
	                                                    #A2 := #A + 1;
	                                                END_IF;
	                                            END_IF;
	                                            #dAbs := ABS(#L2 - #R2);
	                                            #okB := #dAbs <= #cLim OR #dAbs <= ABS(#L - #R) OR (ABS(#L - #R) > #cLim AND #dAbs <= #cCeil);
	                                            IF #okB AND #cBalMode = 1 THEN
	                                                #dAbs := ABS(#F2 - #A2);
	                                                #okB := #dAbs <= #cLim OR #dAbs <= ABS(#F - #A);
	                                            END_IF;
	                                            IF #okB AND #iPas = 0 THEN
	                                                // v1.4 Pass A: exact feasibility of the rest of the sequence
	                                                #okB := #L2 >= 0 AND #L2 <= 24;
	                                                IF #okB THEN
	                                                    #okB := (#FaMask[#qStep] AND SHL(IN := DWORD#16#1, N := INT_TO_USINT(#L2))) <> DWORD#16#0;
	                                                END_IF;
	                                            END_IF;
	                                            IF #okB THEN
	                                                IF #dBay = 0 THEN
	                                                    #dGc := #x + 6;
	                                                ELSE
	                                                    #dGc := #x;
	                                                END_IF;
	                                                IF #x = #sCol THEN
	                                                    #xd := 0;
	                                                ELSE
	                                                    #xd := 1;
	                                                END_IF;
	                                                #qW := #WTab[ABS(#dGc - #srcCol), ABS(#y - #sRow), #xd];
	                                                IF #qNx > 0 THEN
	                                                    IF #x = #SrcX[#qNx] THEN
	                                                        #xd := 0;
	                                                    ELSE
	                                                        #xd := 1;
	                                                    END_IF;
	                                                    #qW := #qW + #WTab[ABS(#dGc - #SrcG[#qNx]), ABS(#y - #SrcY[#qNx]), #xd];
	                                                END_IF;
	                                                IF NOT #found OR #qW < #bestScore THEN
	                                                    #found := TRUE;
	                                                    #bestScore := #qW;
	                                                    #bK := #x * 12 + #y;
	                                                END_IF;
	                                            END_IF;
	                                        END_IF;
	                                    END_FOR;
	                                END_FOR;
	                                IF #found THEN
	                                    EXIT;
	                                END_IF;
	                            END_FOR;
	                            IF NOT #found THEN
	                                #qFail := TRUE;                 // dead end: candidate rejected
	                                EXIT;
	                            END_IF;
	                            // apply (s, d)
	                            #dCol := #bK / 12;
	                            #dRow := #bK MOD 12;
	                            #lT := "Crane_MoveCost"(X0 := #sCol, Y0 := #sRow, B0 := #sBay, X1 := #dCol, Y1 := #dRow, B1 := #dBay,
	                                                    MMode := #cMMode, M => #lMan);
	                            #g[#dBay, #dCol, #dRow] := #SrcId[#si];
	                            #g[#sBay, #sCol, #sRow] := 0;
	                            IF #SrcKind[#si] = 1 THEN
	                                IF #sCol <= 1 THEN
	                                    #L := #L - 1;
	                                ELSE
	                                    #R := #R - 1;
	                                END_IF;
	                                IF #sRow <= 5 THEN
	                                    #F := #F - 1;
	                                ELSE
	                                    #A := #A - 1;
	                                END_IF;
	                            ELSE
	                                IF #dCol <= 1 THEN
	                                    #L := #L + 1;
	                                ELSE
	                                    #R := #R + 1;
	                                END_IF;
	                                IF #dRow <= 5 THEN
	                                    #F := #F + 1;
	                                ELSE
	                                    #A := #A + 1;
	                                END_IF;
	                            END_IF;
	                            #TotT := #TotT + 400 + #lT;
	                            #TotM := #TotM + 2 + INT_TO_DINT(#lMan);
	                            #CdDX[#qStep] := #dCol;
	                            #CdDY[#qStep] := #dRow;
	                            #CdDB[#qStep] := #dBay;
	                            #CdT[#qStep] := #TotT;
	                            #CdM[#qStep] := #TotM;
	                            #cx := #dCol;
	                            #cy := #dRow;
	                            #cb := #dBay;
	                            // bound: every remaining transfer costs >= 400 + 180 ds and 2 M (= 960 weighted)
	                            #kv := (#TotT - #sBaseT) + 190 * (#TotM - #sBaseM);
	                            IF #kv + 960 * INT_TO_DINT(#LsN - #qStep) >= #LsK THEN
	                                #qFail := TRUE;                 // cannot beat the incumbent
	                                EXIT;
	                            END_IF;
	                        END_FOR;
	                        END_IF;
	                        #ImpEvals := #ImpEvals + 1;
	                        #qEv := #qEv + 1;
	                        IF NOT #qFail THEN
	                            // accept (K < LsK is guaranteed by the bound check at the last step)
	                            #ImpAcc := #ImpAcc + 1;
	                            #ItSweepImp := TRUE;
	                            FOR #qQ := #qStart TO #LsN DO
	                                #LsDX[#qQ] := #CdDX[#qQ];
	                                #LsDY[#qQ] := #CdDY[#qQ];
	                                #LsDB[#qQ] := #CdDB[#qQ];
	                                #LsT[#qQ] := #CdT[#qQ];
	                                #LsM[#qQ] := #CdM[#qQ];
	                            END_FOR;
	                            FOR #qQ := 1 TO #LsN DO
	                                #LsSeq[#qQ] := #CdSeq[#qQ];
	                            END_FOR;
	                            #LsK := #kv;
	                        END_IF;
	                    END_IF;

	                    // ---- termination: evaluation budget, or a sweep without improvement ----
	                    #qFin := #ImpEvals >= #cImpEvals;
	                    IF #qEnd AND NOT #qFin THEN
	                        IF #ItSweepImp THEN
	                            #ItSweepImp := FALSE;
	                        ELSE
	                            #qFin := TRUE;
	                        END_IF;
	                    END_IF;
	                    IF #qFin THEN
	                        #ImpActive := FALSE;
	                        #SlStart := TRUE;               // v1.4: SLOT phase, then finalise / publish
	                    END_IF;
	                END_WHILE;

	            ELSIF #SlStart THEN
	                // ================= v1.4: SLOT phase start (CONTRACT 4.11) =================
	                #SlStart := FALSE;
	                IF #cSlotSweeps > 0 AND #LsN >= 1 THEN
	                    FOR #b := 0 TO 1 DO
	                        FOR #x := 0 TO 3 DO
	                            FOR #y := 0 TO 11 DO
	                                IF #sG[#b, #x, #y] = 0 THEN
	                                    #SlAvail[#b, #x, #y] := 1;
	                                ELSE
	                                    #SlAvail[#b, #x, #y] := 999;
	                                END_IF;
	                                #SlUsed[#b, #x, #y] := 0;
	                            END_FOR;
	                        END_FOR;
	                    END_FOR;
	                    FOR #k := 1 TO #LsN DO
	                        #si := #LsSeq[#k];
	                        #SlAvail[#SrcB[#si], #SrcX[#si], #SrcY[#si]] := #k + 1;   // freed by the lift of step k
	                        #SlUsed[#LsDB[#k], #LsDX[#k], #LsDY[#k]] := #k;
	                    END_FOR;
	                    #SlK := 1;
	                    #SlSweep := 1;
	                    #SlImp := FALSE;
	                    #SlActive := TRUE;
	                ELSE
	                    #FinStart := TRUE;
	                END_IF;

	            ELSIF #SlActive THEN
	                // ================= v1.4: SLOT phase, one step k per call (CONTRACT 4.11) =================
	                // The sequence is fixed; only drop cells change. Cost of cell d for step k (separable):
	                // c_k(d) = W(s_k -> d) + W(d -> s_k+1). Candidates in this order, first improvement:
	                //  wC 0..47 : relocate Dst[k] to free cell (wC / 12, wC MOD 12) with SlAvail <= k;
	                //  wC 48..  : swap Dst[k] <-> Dst[q], q = k+1..LsN, same bay, SlAvail[Dst[q]] <= k.
	                // A load that changes ship half (or fore/aft half, BalMode 1) re-checks the step rule
	                // over the whole sequence.
	                #budget := 0;
	                #k := #SlK;
	                #si := #LsSeq[#k];
	                #b := #LsDB[#k];
	                IF #k < #LsN THEN
	                    #qNx := #LsSeq[#k + 1];
	                ELSE
	                    #qNx := 1;                          // any valid index; HasNxt = FALSE ignores it
	                END_IF;
	                #wCur := "Crane_DropCost"(SrcX := #SrcX[#si], SrcY := #SrcY[#si], SrcB := #SrcB[#si],
	                                          CelX := #LsDX[#k], CelY := #LsDY[#k], CelB := #b,
	                                          NxtX := #SrcX[#qNx], NxtY := #SrcY[#qNx], NxtB := #SrcB[#qNx],
	                                          HasNxt := #k < #LsN, MMode := #cMMode);
	                FOR #wC := 0 TO 47 + #LsN DO
	                    #wGo := FALSE;
	                    #wQ := 0;
	                    IF #wC <= 47 THEN
	                        #x := #wC / 12;
	                        #y := #wC MOD 12;
	                        IF #SlUsed[#b, #x, #y] = 0 AND #SlAvail[#b, #x, #y] <= #k THEN
	                            #wC1 := "Crane_DropCost"(SrcX := #SrcX[#si], SrcY := #SrcY[#si], SrcB := #SrcB[#si],
	                                                     CelX := #x, CelY := #y, CelB := #b,
	                                                     NxtX := #SrcX[#qNx], NxtY := #SrcY[#qNx], NxtB := #SrcB[#qNx],
	                                                     HasNxt := #k < #LsN, MMode := #cMMode);
	                            #wGo := #wC1 < #wCur;
	                        END_IF;
	                    ELSE
	                        #wQ := #wC - 47 + #k;
	                        IF #wQ <= #LsN THEN
	                            IF #LsDB[#wQ] = #b THEN
	                                IF #SlAvail[#b, #LsDX[#wQ], #LsDY[#wQ]] <= #k THEN
	                                    #sj := #LsSeq[#wQ];
	                                    IF #wQ < #LsN THEN
	                                        #wNq := #LsSeq[#wQ + 1];
	                                    ELSE
	                                        #wNq := 1;
	                                    END_IF;
	                                    #wC2 := "Crane_DropCost"(SrcX := #SrcX[#sj], SrcY := #SrcY[#sj], SrcB := #SrcB[#sj],
	                                                             CelX := #LsDX[#wQ], CelY := #LsDY[#wQ], CelB := #b,
	                                                             NxtX := #SrcX[#wNq], NxtY := #SrcY[#wNq], NxtB := #SrcB[#wNq],
	                                                             HasNxt := #wQ < #LsN, MMode := #cMMode);
	                                    #wC1 := "Crane_DropCost"(SrcX := #SrcX[#si], SrcY := #SrcY[#si], SrcB := #SrcB[#si],
	                                                             CelX := #LsDX[#wQ], CelY := #LsDY[#wQ], CelB := #b,
	                                                             NxtX := #SrcX[#qNx], NxtY := #SrcY[#qNx], NxtB := #SrcB[#qNx],
	                                                             HasNxt := #k < #LsN, MMode := #cMMode)
	                                            + "Crane_DropCost"(SrcX := #SrcX[#sj], SrcY := #SrcY[#sj], SrcB := #SrcB[#sj],
	                                                               CelX := #LsDX[#k], CelY := #LsDY[#k], CelB := #b,
	                                                               NxtX := #SrcX[#wNq], NxtY := #SrcY[#wNq], NxtB := #SrcB[#wNq],
	                                                               HasNxt := #wQ < #LsN, MMode := #cMMode);
	                                    IF #wC1 < #wCur + #wC2 THEN
	                                        #wGo := TRUE;
	                                        #x := #LsDX[#wQ];
	                                        #y := #LsDY[#wQ];
	                                    END_IF;
	                                END_IF;
	                            END_IF;
	                        ELSE
	                            #wQ := 0;
	                        END_IF;
	                    END_IF;

	                    IF #wGo THEN
	                        // tentative change: Dst[k] := (x, y); swap: Dst[q] := old Dst[k]
	                        #wOx := #LsDX[#k];
	                        #wOy := #LsDY[#k];
	                        #wChk := FALSE;
	                        IF #SrcKind[#si] = 2 THEN
	                            #wChk := ((#x <= 1) <> (#wOx <= 1)) OR (#cBalMode = 1 AND ((#y <= 5) <> (#wOy <= 5)));
	                        END_IF;
	                        IF #wQ > 0 THEN
	                            IF #SrcKind[#LsSeq[#wQ]] = 2 THEN
	                                #wChk := #wChk OR ((#wOx <= 1) <> (#x <= 1)) OR (#cBalMode = 1 AND ((#wOy <= 5) <> (#y <= 5)));
	                            END_IF;
	                        END_IF;
	                        #LsDX[#k] := #x;
	                        #LsDY[#k] := #y;
	                        IF #wQ > 0 THEN
	                            #LsDX[#wQ] := #wOx;
	                            #LsDY[#wQ] := #wOy;
	                        END_IF;
	                        #wTrj := TRUE;
	                        IF #wChk THEN
	                            // step rule along the whole sequence with the changed ship halves
	                            #wLa := #SlBalL;
	                            #wRa := #SlBalR;
	                            #wFa := #SlBalF;
	                            #wAa := #SlBalA;
	                            FOR #qQ := 1 TO #LsN DO
	                                #sj := #LsSeq[#qQ];
	                                IF #SrcKind[#sj] = 1 THEN
	                                    IF #SrcX[#sj] <= 1 THEN
	                                        #L2 := #wLa - 1;
	                                        #R2 := #wRa;
	                                    ELSE
	                                        #L2 := #wLa;
	                                        #R2 := #wRa - 1;
	                                    END_IF;
	                                    IF #SrcY[#sj] <= 5 THEN
	                                        #F2 := #wFa - 1;
	                                        #A2 := #wAa;
	                                    ELSE
	                                        #F2 := #wFa;
	                                        #A2 := #wAa - 1;
	                                    END_IF;
	                                ELSE
	                                    IF #LsDX[#qQ] <= 1 THEN
	                                        #L2 := #wLa + 1;
	                                        #R2 := #wRa;
	                                    ELSE
	                                        #L2 := #wLa;
	                                        #R2 := #wRa + 1;
	                                    END_IF;
	                                    IF #LsDY[#qQ] <= 5 THEN
	                                        #F2 := #wFa + 1;
	                                        #A2 := #wAa;
	                                    ELSE
	                                        #F2 := #wFa;
	                                        #A2 := #wAa + 1;
	                                    END_IF;
	                                END_IF;
	                                #dAbs := ABS(#L2 - #R2);
	                                #okB := #dAbs <= #cLim OR #dAbs <= ABS(#wLa - #wRa) OR (ABS(#wLa - #wRa) > #cLim AND #dAbs <= #cCeil);
	                                IF #okB AND #cBalMode = 1 THEN
	                                    #dAbs := ABS(#F2 - #A2);
	                                    #okB := #dAbs <= #cLim OR #dAbs <= ABS(#wFa - #wAa);
	                                END_IF;
	                                IF NOT #okB THEN
	                                    #wTrj := FALSE;
	                                    EXIT;
	                                END_IF;
	                                #wLa := #L2;
	                                #wRa := #R2;
	                                #wFa := #F2;
	                                #wAa := #A2;
	                            END_FOR;
	                            IF #wTrj AND #cCeil > 0 AND ABS(#wLa - #wRa) > #cLim THEN
	                                #wTrj := FALSE;         // v1.5: a relaxed plan must end balanced
	                            END_IF;
	                        END_IF;
	                        IF NOT #wTrj THEN
	                            // revert
	                            #LsDX[#k] := #wOx;
	                            #LsDY[#k] := #wOy;
	                            IF #wQ > 0 THEN
	                                #LsDX[#wQ] := #x;
	                                #LsDY[#wQ] := #y;
	                            END_IF;
	                        ELSE
	                            IF #wQ > 0 THEN
	                                #SlUsed[#b, #x, #y] := #k;
	                                #SlUsed[#b, #wOx, #wOy] := #wQ;
	                                #wCur := "Crane_DropCost"(SrcX := #SrcX[#si], SrcY := #SrcY[#si], SrcB := #SrcB[#si],
	                                                          CelX := #x, CelY := #y, CelB := #b,
	                                                          NxtX := #SrcX[#qNx], NxtY := #SrcY[#qNx], NxtB := #SrcB[#qNx],
	                                                          HasNxt := #k < #LsN, MMode := #cMMode);
	                            ELSE
	                                #SlUsed[#b, #wOx, #wOy] := 0;
	                                #SlUsed[#b, #x, #y] := #k;
	                                #wCur := #wC1;
	                            END_IF;
	                            #SlImp := TRUE;
	                            #SlAcc := #SlAcc + 1;
	                        END_IF;
	                    END_IF;
	                END_FOR;
	                #SlK := #SlK + 1;
	                IF #SlK > #LsN THEN
	                    IF #SlImp AND #SlSweep < #cSlotSweeps THEN
	                        #SlSweep := #SlSweep + 1;
	                        #SlK := 1;
	                        #SlImp := FALSE;
	                    ELSE
	                        #SlActive := FALSE;
	                        #FinStart := TRUE;
	                    END_IF;
	                END_IF;

	            ELSIF #FinStart THEN
	                // ================= v1.4: finalise (cumulative T / M, result -> BestPlan) =================
	                #FinStart := FALSE;
	                IF #SlAcc > 0 THEN
	                    #cx := #sCx;
	                    #cy := #sCy;
	                    #cb := #sCb;
	                    #TotT := #sBaseT;
	                    #TotM := #sBaseM;
	                    FOR #k := 1 TO #LsN DO
	                        #si := #LsSeq[#k];
	                        IF #cx <> #SrcX[#si] OR #cy <> #SrcY[#si] OR #cb <> #SrcB[#si] THEN
	                            #eT := "Crane_MoveCost"(X0 := #cx, Y0 := #cy, B0 := #cb, X1 := #SrcX[#si], Y1 := #SrcY[#si], B1 := #SrcB[#si],
	                                                    MMode := #cMMode, M => #eMan);
	                            #TotT := #TotT + #eT;
	                            #TotM := #TotM + INT_TO_DINT(#eMan);
	                        END_IF;
	                        #lT := "Crane_MoveCost"(X0 := #SrcX[#si], Y0 := #SrcY[#si], B0 := #SrcB[#si], X1 := #LsDX[#k], Y1 := #LsDY[#k], B1 := #LsDB[#k],
	                                                MMode := #cMMode, M => #lMan);
	                        #TotT := #TotT + 400 + #lT;
	                        #TotM := #TotM + 2 + INT_TO_DINT(#lMan);
	                        #LsT[#k] := #TotT;
	                        #LsM[#k] := #TotM;
	                        #cx := #LsDX[#k];
	                        #cy := #LsDY[#k];
	                        #cb := #LsDB[#k];
	                    END_FOR;
	                    #LsK := (#TotT - #sBaseT) + 190 * (#TotM - #sBaseM);
	                END_IF;
	                IF #ImpAcc > 0 OR #SlAcc > 0 THEN
	                    FOR #qQ := 1 TO #LsN DO
	                        #si := #LsSeq[#qQ];
	                        #BestPlan[#qQ].Kind := #SrcKind[#si];
	                        #BestPlan[#qQ].Id := #SrcId[#si];
	                        #BestPlan[#qQ].ListIdx := #SrcIdx[#si];
	                        #BestPlan[#qQ].SrcX := INT_TO_SINT(#SrcX[#si]);
	                        #BestPlan[#qQ].SrcY := INT_TO_SINT(#SrcY[#si]);
	                        #BestPlan[#qQ].SrcBay := INT_TO_USINT(#SrcB[#si]);
	                        #BestPlan[#qQ].DstX := INT_TO_SINT(#LsDX[#qQ]);
	                        #BestPlan[#qQ].DstY := INT_TO_SINT(#LsDY[#qQ]);
	                        #BestPlan[#qQ].DstBay := INT_TO_USINT(#LsDB[#qQ]);
	                        #BestPlan[#qQ].CumT_ds := #LsT[#qQ];
	                        #BestPlan[#qQ].CumM := #LsM[#qQ];
	                    END_FOR;
	                    #BestT := #LsT[#LsN];
	                    #BestM := #LsM[#LsN];
	                    #BestK := #LsK;
	                END_IF;
	                #PubPending := TRUE;

	            ELSIF NOT #VarActive THEN
	                // ---------- initialise variant VarNo ----------
	                #VarActive := TRUE;
	                #VarErr := 0;
	                #Alpha := #cAlpha[#VarNo];
	                FOR #b := 0 TO 1 DO
	                    FOR #x := 0 TO 3 DO
	                        FOR #y := 0 TO 11 DO
	                            #g[#b, #x, #y] := #sG[#b, #x, #y];
	                        END_FOR;
	                    END_FOR;
	                END_FOR;
	                FOR #i := 1 TO 96 DO
	                    #Pend[#i] := #i <= #nSrc;
	                END_FOR;
	                #nPend := #nSrc;
	                #cx := #sCx;
	                #cy := #sCy;
	                #cb := #sCb;
	                IF #cb = 0 THEN
	                    #cG := #cx + 6;
	                ELSE
	                    #cG := #cx;
	                END_IF;
	                #TotT := #sBaseT;
	                #TotM := #sBaseM;
	                #CurLen := 0;

	            ELSIF #VarErr <> 0 OR #nPend = 0 THEN
	                // ---------- close variant VarNo ----------
	                #DiagVarErr[#VarNo] := #VarErr;
	                IF #VarErr = 0 THEN
	                    #kv := (#TotT - #sBaseT) + 190 * (#TotM - #sBaseM);
	                    #DiagVarK[#VarNo] := #kv;
	                    IF NOT #HaveBest OR #kv < #BestK THEN
	                        #HaveBest := TRUE;
	                        #BestV := #VarNo;
	                        #BestK := #kv;
	                        #BestT := #TotT;
	                        #BestM := #TotM;
	                        #BestLen := #CurLen;
	                        FOR #i := 1 TO #CurLen DO
	                            #BestPlan[#i] := #CurPlan[#i];
	                            #BestSrc[#i] := #CurSrc[#i];
	                        END_FOR;
	                    END_IF;
	                ELSIF #VarNo = 1 THEN
	                    #Err1 := #VarErr;
	                END_IF;
	                #VarActive := FALSE;
	                #VarNo := #VarNo + 1;

	                IF #VarNo > #cVariants THEN
	                    #GrT := #BestT;
	                    #GrM := #BestM;
	                    IF #HaveBest THEN
	                        // ---------- incumbent = greedy winner; IMPROVE (4.8) if enabled, then SLOT (4.11) ----------
	                        #LsN := #BestLen;
	                        #LsT[0] := #sBaseT;
	                        #LsM[0] := #sBaseM;
	                        FOR #i := 1 TO #BestLen DO
	                            #LsSeq[#i] := #BestSrc[#i];
	                            #LsDX[#i] := SINT_TO_INT(#BestPlan[#i].DstX);
	                            #LsDY[#i] := SINT_TO_INT(#BestPlan[#i].DstY);
	                            #LsDB[#i] := USINT_TO_INT(#BestPlan[#i].DstBay);
	                            #LsT[#i] := #BestPlan[#i].CumT_ds;
	                            #LsM[#i] := #BestPlan[#i].CumM;
	                        END_FOR;
	                        #LsK := #BestK;
	                        IF #cImpEvals > 0 AND #cOrder <> 2 AND #BestLen >= 2 THEN
	                            #ItMv := 0;
	                            #ItI := 1;
	                            #ItJ := 1;
	                            #ItSweepImp := FALSE;
	                            #ImpActive := TRUE;
	                        ELSE
	                            #SlStart := TRUE;
	                        END_IF;
	                    ELSE
	                        #PubPending := TRUE;
	                    END_IF;
	                END_IF;

	            ELSE
	                // ---------- one greedy step (CONTRACT 4.4) ----------
	                #budget := #budget - 1;
	                #DiagSteps := #DiagSteps + 1;

	                // ship balance now
	                #L := 0;
	                #R := 0;
	                #F := 0;
	                #A := 0;
	                FOR #x := 0 TO 3 DO
	                    FOR #y := 0 TO 11 DO
	                        IF #g[0, #x, #y] <> 0 THEN
	                            IF #x <= 1 THEN
	                                #L := #L + 1;
	                            ELSE
	                                #R := #R + 1;
	                            END_IF;
	                            IF #y <= 5 THEN
	                                #F := #F + 1;
	                            ELSE
	                                #A := #A + 1;
	                            END_IF;
	                        END_IF;
	                    END_FOR;
	                END_FOR;

	                // pending statistics (all pending, for reachability) and the eligible set ES
	                #uLt := 0;
	                #uRt := 0;
	                #nLt := 0;
	                #fU := 0;
	                #fU2 := 0;
	                #fL := 0;
	                #fL2 := 0;
	                #nEs := 0;
	                FOR #i := 1 TO #nSrc DO
	                    IF #Pend[#i] THEN
	                        IF #SrcKind[#i] = 1 THEN
	                            IF #SrcX[#i] <= 1 THEN
	                                #uLt := #uLt + 1;
	                            ELSE
	                                #uRt := #uRt + 1;
	                            END_IF;
	                            IF #fU = 0 THEN
	                                #fU := #i;
	                            ELSIF #fU2 = 0 THEN
	                                #fU2 := #i;
	                            END_IF;
	                        ELSE
	                            #nLt := #nLt + 1;
	                            IF #fL = 0 THEN
	                                #fL := #i;
	                            ELSIF #fL2 = 0 THEN
	                                #fL2 := #i;
	                            END_IF;
	                        END_IF;
	                        IF #cOrder = 0 THEN
	                            #nEs := #nEs + 1;
	                            #Es[#nEs] := #i;
	                        END_IF;
	                    END_IF;
	                END_FOR;
	                IF #cOrder = 1 THEN
	                    IF #fU > 0 THEN
	                        #nEs := #nEs + 1;
	                        #Es[#nEs] := #fU;
	                    END_IF;
	                    IF #fL > 0 THEN
	                        #nEs := #nEs + 1;
	                        #Es[#nEs] := #fL;
	                    END_IF;
	                ELSIF #cOrder = 2 THEN
	                    IF #fU > 0 THEN
	                        #nEs := 1;
	                        #Es[1] := #fU;
	                    ELSIF #fL > 0 THEN
	                        #nEs := 1;
	                        #Es[1] := #fL;
	                    END_IF;
	                END_IF;

	                // free cells per bay (scan order x outer, y inner)
	                FOR #b := 0 TO 1 DO
	                    #nFree[#b] := 0;
	                    FOR #x := 0 TO 3 DO
	                        FOR #y := 0 TO 11 DO
	                            IF #g[#b, #x, #y] = 0 THEN
	                                #nFree[#b] := #nFree[#b] + 1;
	                                #FreeX[#b, #nFree[#b]] := #x;
	                                #FreeY[#b, #nFree[#b]] := #y;
	                                IF #b = 0 THEN
	                                    #FreeG[#b, #nFree[#b]] := #x + 6;
	                                ELSE
	                                    #FreeG[#b, #nFree[#b]] := #x;
	                                END_IF;
	                            END_IF;
	                        END_FOR;
	                    END_FOR;
	                END_FOR;

	                // OrderMode 0 lookahead: best / second best W(d -> s') over ES per free cell
	                IF #cOrder = 0 AND #Alpha <> 0 THEN
	                    FOR #b := 0 TO 1 DO
	                        FOR #k := 1 TO #nFree[#b] DO
	                            #B1[#b, #k] := -1;
	                            #B1Own[#b, #k] := 0;
	                            #B2[#b, #k] := -1;
	                            #dCol := #FreeX[#b, #k];
	                            #dRow := #FreeY[#b, #k];
	                            #dGc := #FreeG[#b, #k];
	                            FOR #ie := 1 TO #nEs DO
	                                #sj := #Es[#ie];
	                                IF #dCol = #SrcX[#sj] THEN
	                                    #xd := 0;
	                                ELSE
	                                    #xd := 1;
	                                END_IF;
	                                #wv := #WTab[ABS(#dGc - #SrcG[#sj]), ABS(#dRow - #SrcY[#sj]), #xd];
	                                IF #B1[#b, #k] < 0 OR #wv < #B1[#b, #k] THEN
	                                    #B2[#b, #k] := #B1[#b, #k];
	                                    #B1[#b, #k] := #wv;
	                                    #B1Own[#b, #k] := #sj;
	                                ELSIF #B2[#b, #k] < 0 OR #wv < #B2[#b, #k] THEN
	                                    #B2[#b, #k] := #wv;
	                                END_IF;
	                            END_FOR;
	                        END_FOR;
	                    END_FOR;
	                END_IF;

	                // candidates: Pass A (step rule + reachability), Pass B (step rule only) if A is empty
	                #found := FALSE;
	                #bestScore := 0;
	                #bS := 0;
	                #bK := 0;
	                #bDb := 0;
	                FOR #iPas := 0 TO 1 DO
	                    FOR #ie := 1 TO #nEs DO
	                        #si := #Es[#ie];
	                        #sCol := #SrcX[#si];
	                        #sRow := #SrcY[#si];
	                        #sBay := #SrcB[#si];
	                        #srcCol := #SrcG[#si];
	                        #dBay := 1 - #sBay;
	                        // E = W(crane -> s), 0 if the crane is already there
	                        IF #cx = #sCol THEN
	                            #xd := 0;
	                        ELSE
	                            #xd := 1;
	                        END_IF;
	                        #Ew := #WTab[ABS(#cG - #srcCol), ABS(#cy - #sRow), #xd];
	                        // OrderMode 1/2: next eligible set ES' with s removed (at most 2 entries)
	                        #nx1 := 0;
	                        #nx2 := 0;
	                        IF #cOrder <> 0 THEN
	                            #nxU := #fU;
	                            IF #nxU = #si THEN
	                                #nxU := #fU2;
	                            END_IF;
	                            #nxL := #fL;
	                            IF #nxL = #si THEN
	                                #nxL := #fL2;
	                            END_IF;
	                            IF #cOrder = 1 THEN
	                                #nx1 := #nxU;
	                                #nx2 := #nxL;
	                            ELSIF #nxU > 0 THEN
	                                #nx1 := #nxU;
	                            ELSE
	                                #nx1 := #nxL;
	                            END_IF;
	                        END_IF;
	                        // balance effect of an unload does not depend on d
	                        IF #SrcKind[#si] = 1 THEN
	                            IF #sCol <= 1 THEN
	                                #L2 := #L - 1;
	                                #R2 := #R;
	                                #uL := #uLt - 1;
	                                #uR := #uRt;
	                            ELSE
	                                #L2 := #L;
	                                #R2 := #R - 1;
	                                #uL := #uLt;
	                                #uR := #uRt - 1;
	                            END_IF;
	                            IF #sRow <= 5 THEN
	                                #F2 := #F - 1;
	                                #A2 := #A;
	                            ELSE
	                                #F2 := #F;
	                                #A2 := #A - 1;
	                            END_IF;
	                            #nL := #nLt;
	                        ELSE
	                            #uL := #uLt;
	                            #uR := #uRt;
	                            #nL := #nLt - 1;
	                        END_IF;

	                        FOR #k := 1 TO #nFree[#dBay] DO
	                            #dCol := #FreeX[#dBay, #k];
	                            #dRow := #FreeY[#dBay, #k];
	                            #dGc := #FreeG[#dBay, #k];
	                            IF #SrcKind[#si] = 2 THEN
	                                IF #dCol <= 1 THEN
	                                    #L2 := #L + 1;
	                                    #R2 := #R;
	                                ELSE
	                                    #L2 := #L;
	                                    #R2 := #R + 1;
	                                END_IF;
	                                IF #dRow <= 5 THEN
	                                    #F2 := #F + 1;
	                                    #A2 := #A;
	                                ELSE
	                                    #F2 := #F;
	                                    #A2 := #A + 1;
	                                END_IF;
	                            END_IF;
	                            // step rule: OK if |L'-R'| <= Lim or not worse than now
	                            #dAbs := ABS(#L2 - #R2);
	                            #okB := #dAbs <= #cLim OR #dAbs <= ABS(#L - #R) OR (ABS(#L - #R) > #cLim AND #dAbs <= #cCeil);
	                            IF #okB AND #cBalMode = 1 THEN
	                                #dAbs := ABS(#F2 - #A2);
	                                #okB := #dAbs <= #cLim OR #dAbs <= ABS(#F - #A);
	                            END_IF;
	                            // Pass A: order 1 / 2: exact list-order feasibility of the post-step state (v1.4,
	                            // FtMask); order 0: reachability of a balanced end state (x-split)
	                            IF #okB AND #iPas = 0 AND #FtUse THEN
	                                #okB := #L2 >= 0 AND #L2 <= 24;
	                                IF #okB THEN
	                                    #okB := (#FtMask[#FtNu - #uL - #uR, #FtNl - #nL]
	                                             AND SHL(IN := DWORD#16#1, N := INT_TO_USINT(#L2))) <> DWORD#16#0;
	                                END_IF;
	                            ELSIF #okB AND #iPas = 0 THEN
	                                #Lbase := #L2 - #uL;
	                                #Rbase := #R2 - #uR;
	                                #loN := #nL - (24 - #Rbase);
	                                IF #loN < 0 THEN
	                                    #loN := 0;
	                                END_IF;
	                                #hiN := 24 - #Lbase;
	                                IF #nL < #hiN THEN
	                                    #hiN := #nL;
	                                END_IF;
	                                #Dbase := #Lbase - #Rbase - #nL;
	                                #okB := #loN <= #hiN AND #Dbase + 2 * #loN <= #cLim AND #Dbase + 2 * #hiN >= -#cLim;
	                            END_IF;
	                            IF #okB THEN
	                                // Lm = W(s -> d)
	                                IF #dCol = #sCol THEN
	                                    #xd := 0;
	                                ELSE
	                                    #xd := 1;
	                                END_IF;
	                                #Lm := #WTab[ABS(#dGc - #srcCol), ABS(#dRow - #sRow), #xd];
	                                // Nx = min over ES' of W(d -> s'), 0 if ES' is empty
	                                #Nx := 0;
	                                IF #Alpha <> 0 THEN
	                                    IF #cOrder = 0 THEN
	                                        IF #B1Own[#dBay, #k] <> #si THEN
	                                            #Nx := #B1[#dBay, #k];
	                                        ELSIF #B2[#dBay, #k] >= 0 THEN
	                                            #Nx := #B2[#dBay, #k];
	                                        END_IF;
	                                    ELSE
	                                        #nxFirst := TRUE;
	                                        FOR #j := 1 TO 2 DO
	                                            IF #j = 1 THEN
	                                                #sj := #nx1;
	                                            ELSE
	                                                #sj := #nx2;
	                                            END_IF;
	                                            IF #sj > 0 THEN
	                                                IF #dCol = #SrcX[#sj] THEN
	                                                    #xd := 0;
	                                                ELSE
	                                                    #xd := 1;
	                                                END_IF;
	                                                #wv := #WTab[ABS(#dGc - #SrcG[#sj]), ABS(#dRow - #SrcY[#sj]), #xd];
	                                                IF #nxFirst OR #wv < #Nx THEN
	                                                    #Nx := #wv;
	                                                    #nxFirst := FALSE;
	                                                END_IF;
	                                            END_IF;
	                                        END_FOR;
	                                    END_IF;
	                                END_IF;
	                                #score := 100 * (#Ew + #Lm) + #Alpha * #Nx;
	                                // strict '<': the first candidate in scan order wins ties
	                                IF NOT #found OR #score < #bestScore THEN
	                                    #found := TRUE;
	                                    #bestScore := #score;
	                                    #bS := #si;
	                                    #bK := #k;
	                                    #bDb := #dBay;
	                                END_IF;
	                            END_IF;
	                        END_FOR;
	                    END_FOR;
	                    IF #found THEN
	                        EXIT;
	                    END_IF;
	                END_FOR;

	                IF NOT #found THEN
	                    #VarErr := 1;                       // no feasible transfer
	                ELSIF #CurLen >= 96 THEN
	                    #VarErr := 2;                       // plan longer than 96 transfers
	                ELSE
	                    // ---------- apply the best (s, d) ----------
	                    #si := #bS;
	                    #sCol := #SrcX[#si];
	                    #sRow := #SrcY[#si];
	                    #sBay := #SrcB[#si];
	                    #dBay := #bDb;
	                    #dCol := #FreeX[#dBay, #bK];
	                    #dRow := #FreeY[#dBay, #bK];
	                    #eT := "Crane_MoveCost"(X0 := #cx, Y0 := #cy, B0 := #cb, X1 := #sCol, Y1 := #sRow, B1 := #sBay,
	                                            MMode := #cMMode, M => #eMan);
	                    #lT := "Crane_MoveCost"(X0 := #sCol, Y0 := #sRow, B0 := #sBay, X1 := #dCol, Y1 := #dRow, B1 := #dBay,
	                                            MMode := #cMMode, M => #lMan);
	                    #g[#dBay, #dCol, #dRow] := #g[#sBay, #sCol, #sRow];
	                    #g[#sBay, #sCol, #sRow] := 0;
	                    #TotT := #TotT + #eT + 200 + #lT + 200;
	                    #TotM := #TotM + INT_TO_DINT(#eMan) + 1 + INT_TO_DINT(#lMan) + 1;
	                    #CurLen := #CurLen + 1;
	                    #CurPlan[#CurLen].Kind := #SrcKind[#si];
	                    #CurPlan[#CurLen].Id := #SrcId[#si];
	                    #CurPlan[#CurLen].ListIdx := #SrcIdx[#si];
	                    #CurPlan[#CurLen].SrcX := INT_TO_SINT(#sCol);
	                    #CurPlan[#CurLen].SrcY := INT_TO_SINT(#sRow);
	                    #CurPlan[#CurLen].SrcBay := INT_TO_USINT(#sBay);
	                    #CurPlan[#CurLen].DstX := INT_TO_SINT(#dCol);
	                    #CurPlan[#CurLen].DstY := INT_TO_SINT(#dRow);
	                    #CurPlan[#CurLen].DstBay := INT_TO_USINT(#dBay);
	                    #CurPlan[#CurLen].CumT_ds := #TotT;
	                    #CurPlan[#CurLen].CumM := #TotM;
	                    #CurSrc[#CurLen] := #si;
	                    #cx := #dCol;
	                    #cy := #dRow;
	                    #cb := #dBay;
	                    #cG := #FreeG[#dBay, #bK];
	                    #Pend[#si] := FALSE;
	                    #nPend := #nPend - 1;
	                END_IF;
	            END_IF;

	            IF #PubPending THEN
	                // ---------- job finished: publish (World is written only here) ----------
	                #PubPending := FALSE;
	                IF #HaveBest THEN
	                    FOR #i := 1 TO 96 DO
	                        IF #i <= #BestLen THEN
	                            "World".Plan[#i] := #BestPlan[#i];
	                        ELSE
	                            "World".Plan[#i] := #ZeroTr;
	                        END_IF;
	                    END_FOR;
	                    "World".PlanLen := #BestLen;
	                    "World".PlanVariant := #BestV;
	                    "World".PredT_ds := #BestT;
	                    "World".PredM := #BestM;
	                    "World".LbT_ds := #sBaseT + #LbT;
	                    "World".LbM := #sBaseM + #LbM;
	                    "World".ImpEvals := #ImpEvals;
	                    "World".ImpAccepts := #ImpAcc;
	                    "World".SlotAccepts := #SlAcc;
	                    "World".OrderFeasible := #OrderOk;
	                    IF #sN > 0 THEN
	                        "World".PredJ := 0.5 * (DINT_TO_REAL(#BestT) / 10.0) / (76.0 * INT_TO_REAL(#sN))
	                                       + 0.5 * DINT_TO_REAL(#BestM) / (4.0 * INT_TO_REAL(#sN));
	                        "World".PredJ0 := 0.5 * (DINT_TO_REAL(#GrT) / 10.0) / (76.0 * INT_TO_REAL(#sN))
	                                        + 0.5 * DINT_TO_REAL(#GrM) / (4.0 * INT_TO_REAL(#sN));
	                        "World".LbJ := 0.5 * (DINT_TO_REAL(#sBaseT + #LbT) / 10.0) / (76.0 * INT_TO_REAL(#sN))
	                                     + 0.5 * DINT_TO_REAL(#sBaseM + #LbM) / (4.0 * INT_TO_REAL(#sN));
	                    ELSE
	                        "World".PredJ := 0.0;
	                        "World".PredJ0 := 0.0;
	                        "World".LbJ := 0.0;
	                    END_IF;
	                    "World".PlanValid := TRUE;
	                    #Done := TRUE;
	                    #ErrCode := 0;
	                ELSE
	                    "World".PlanValid := FALSE;
	                    "World".PlanLen := 0;
	                    "World".PlanVariant := 0;
	                    "World".SlotAccepts := 0;
	                    "World".OrderFeasible := #OrderOk;
	                    #Error := TRUE;
	                    #ErrCode := #Err1;
	                END_IF;
	                #JobBusy := FALSE;
	            END_IF;
	        END_WHILE;
	        #DiagCallMs := RUNTIME(MEM := #RtMem) * 1000.0;
	        #DiagJobMs := #DiagJobMs + #DiagCallMs;
	        IF #DiagCallMs > #DiagMaxCallMs THEN
	            #DiagMaxCallMs := #DiagCallMs;
	        END_IF;
	    END_IF;
	END_REGION
	
	#Busy := #JobBusy;
END_FUNCTION_BLOCK

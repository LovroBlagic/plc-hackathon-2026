FUNCTION_BLOCK "Crane_Control"
TITLE = Container crane control (FB10, called from OB1)
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
//  FB10 decides WHAT the crane does; OB30 decides WHEN (CONTRACT 3.4).
//  - HMI buttons, modes AUTO / SEMI-AUTO / MANUAL
//  - state machine OFF / INIT / READY / RUNNING / PAUSED / ALARM / DONE / PLANNING
//  - INIT: reset FB1, copy DB10/DB11, validate lists and IDs, call the planner
//  - stages plan commands into "World".NextCmd (handshake CmdReady / Permit)
//  - tracks progress (done pointer), list states, ship balance, alarms
//  - writes every indicator of "HMI_IF"
//  FB10 never calls FB1 and never writes MB100..MB103; FB1 tags are read-only here.
   VAR
      Planner : "Crane_Planner";             // planning algorithm (FB11, CONTRACT 4)
      PlanReq : Bool;                        // Req input of the planner
      PlanFinished : Bool;                   // planner job ended, result not yet consumed
      PlanOk : Bool;
      PlanErr : Int;
      PlanStep : Int;                        // PLANNING sub-step
      PlanCrX : SInt;                        // crane position at plan request
      PlanCrY : SInt;
      PlanCrBay : USInt;
      FirstPh : Array[1..96] of USInt;       // first phase of each transfer (1 = move-to-src skipped)
      State : USInt;                         // 0 OFF,1 INIT,2 READY,3 RUNNING,4 PAUSED,5 ALARM,6 DONE,7 PLANNING
      PrevState : USInt;                     // state to return to after ALARM + ACK
      OffState : USInt;                      // state before OFF
      Mode : USInt := 1;                     // 1 AUTO, 2 SEMI, 3 MANUAL
      PendMode : USInt;                      // mode press waiting to be applied
      Initialized : Bool;
      InitStep : Int;                        // INIT sub-step
      InitSeq : UDInt;                       // DoneSeq when the INIT reset was staged
      SeenSeq : UDInt;                       // last "World".DoneSeq processed
      Resync : Bool;                         // re-align staging cursor to done pointer before staging
      SemiTokens : Int;                      // SEMI: commands still allowed by BtnStep
      AlarmLatch : Word;                     // latched alarm bits (CONTRACT 3.3)
      AlarmPrev : Word;                      // for raise-edge detection (history)
      AlarmHistM : Array[0..15] of UDInt;    // M at each history entry (parallel to HMI_IF.AlarmHist)
      AlarmHistT : Array[0..15] of Real;     // T [s] at each history entry
      FirstScan : Bool := TRUE;
   END_VAR

   VAR_TEMP
      bInit : Bool;                          // button snapshots (HMI bits are reset at once)
      bAuto : Bool;
      bSemi : Bool;
      bManual : Bool;
      bStart : Bool;
      bStop : Bool;
      bAck : Bool;
      bStep : Bool;
      bManExec : Bool;
      i : Int;
      j : Int;
      k : Int;
      x : Int;
      y : Int;
      b : Int;
      id : UInt;
      found : Bool;
      found0 : Bool;
      found1 : Bool;
      cnt : Int;
      cnt2 : Int;
      pu : Int;
      pl : Int;
      seq : UDInt;
      last : "typeCmd";
      cur : "typeCmd";
      blocking : Bool;
      hadFault : Bool;
      carriedOk : Bool;
      newBits : Word;
      newFault : Word;
      tc : Array[0..95] of UInt;             // INIT: all cells, index bay*48 + x*12 + y
      tl : Array[1..96] of UInt;             // INIT: UList (1..48) then LList (49..96)
      ts : Array[1..96] of USInt;            // INIT: states of tl
      rN : Real;
      curValid : Bool;
      tr : "typeTransfer";
   END_VAR


BEGIN
	REGION 0 First scan after PLC start
	    IF #FirstScan THEN
	        FOR #i := 0 TO 15 DO
	            "HMI_IF".AlarmHist[#i] := -1;      // -1 = empty history entry
	        END_FOR;
	        #Mode := 1;                            // default AUTO
	        #State := 0;
	        #FirstScan := FALSE;
	    END_IF;
	END_REGION

	REGION 1 HMI buttons: snapshot and reset
	    #bInit := "HMI_IF".BtnInit;       "HMI_IF".BtnInit := FALSE;
	    #bAuto := "HMI_IF".BtnAuto;       "HMI_IF".BtnAuto := FALSE;
	    #bSemi := "HMI_IF".BtnSemi;       "HMI_IF".BtnSemi := FALSE;
	    #bManual := "HMI_IF".BtnManual;   "HMI_IF".BtnManual := FALSE;
	    #bStart := "HMI_IF".BtnStart;     "HMI_IF".BtnStart := FALSE;
	    #bStop := "HMI_IF".BtnStop;       "HMI_IF".BtnStop := FALSE;
	    #bAck := "HMI_IF".BtnAck;         "HMI_IF".BtnAck := FALSE;
	    #bStep := "HMI_IF".BtnStep;       "HMI_IF".BtnStep := FALSE;
	    #bManExec := "HMI_IF".BtnManExec; "HMI_IF".BtnManExec := FALSE;
	END_REGION

	REGION 2 Planner call (multi-instance; runs a few greedy steps per OB1 cycle)
	    #Planner(Req := #PlanReq);
	    IF #PlanReq AND (#Planner.Done OR #Planner.Error) THEN
	        #PlanFinished := TRUE;
	        #PlanOk := #Planner.Done AND NOT #Planner.Error;
	        #PlanErr := #Planner.ErrCode;
	        #PlanReq := FALSE;                     // falling edge clears Done/Error
	    END_IF;
	END_REGION

	REGION 3 Completed commands: done pointer, list states, manual commands
	    // Read DoneSeq, then LastDone, then DoneSeq again: if OB30 ran in between,
	    // skip this cycle and take a consistent snapshot in the next one.
	    #seq := "World".DoneSeq;
	    #last := "World".LastDone;
	    IF #seq <> #SeenSeq AND #seq = "World".DoneSeq THEN
	        #SeenSeq := #seq;

	        // Plan command finished: advance the done pointer (PlanIdx / Phase)
	        IF (#last.Src = 1 OR #last.Src = 2) AND "World".PlanValid
	            AND #last.TrIdx = "World".PlanIdx AND #last.Phase = "World".Phase
	        THEN
	            IF "World".Phase >= 3 THEN
	                "World".PlanIdx := "World".PlanIdx + 1;
	                IF "World".PlanIdx >= 1 AND "World".PlanIdx <= "World".PlanLen AND "World".PlanIdx <= 96 THEN
	                    "World".Phase := #FirstPh["World".PlanIdx];
	                ELSE
	                    "World".Phase := 0;
	                END_IF;
	            ELSE
	                "World".Phase := "World".Phase + 1;
	            END_IF;
	        END_IF;

	        // Manual command finished: the plan no longer matches the yard -> replan on START
	        IF #last.Src = 3 THEN
	            "World".PlanValid := FALSE;
	            IF #State = 6 THEN
	                #State := 4;                   // DONE -> PAUSED (lists may be pending again)
	            END_IF;
	            IF #State <> 3 THEN
	                "World".Permit := FALSE;
	            END_IF;
	        END_IF;

	        // After every PUT: refresh the list states from the container model
	        IF #last.Cmd = 2 THEN
	            FOR #i := 1 TO 48 DO
	                // unload entry: done when its ID is in Bay1, pending again if back in Bay0
	                #id := "World".UList[#i];
	                IF #id <> 0 AND "World".UState[#i] <= 1 THEN
	                    #found0 := FALSE;
	                    #found1 := FALSE;
	                    FOR #x := 0 TO 3 DO
	                        FOR #y := 0 TO 11 DO
	                            IF "World".Bay0[#x, #y] = #id THEN #found0 := TRUE; END_IF;
	                            IF "World".Bay1[#x, #y] = #id THEN #found1 := TRUE; END_IF;
	                        END_FOR;
	                    END_FOR;
	                    IF "World".UState[#i] = 0 AND #found1 THEN
	                        "World".UState[#i] := 1;
	                    ELSIF "World".UState[#i] = 1 AND #found0 THEN
	                        "World".UState[#i] := 0;
	                    END_IF;
	                END_IF;
	                // load entry: done when its ID is in Bay0, pending again if back in Bay1
	                #id := "World".LList[#i];
	                IF #id <> 0 AND "World".LState[#i] <= 1 THEN
	                    #found0 := FALSE;
	                    #found1 := FALSE;
	                    FOR #x := 0 TO 3 DO
	                        FOR #y := 0 TO 11 DO
	                            IF "World".Bay0[#x, #y] = #id THEN #found0 := TRUE; END_IF;
	                            IF "World".Bay1[#x, #y] = #id THEN #found1 := TRUE; END_IF;
	                        END_FOR;
	                    END_FOR;
	                    IF "World".LState[#i] = 0 AND #found0 THEN
	                        "World".LState[#i] := 1;
	                    ELSIF "World".LState[#i] = 1 AND #found1 THEN
	                        "World".LState[#i] := 0;
	                    END_IF;
	                END_IF;
	            END_FOR;
	        END_IF;
	    END_IF;
	END_REGION

	REGION 4 Ship balance (continuous) and configuration
	    "World".BalL := 0;
	    "World".BalR := 0;
	    "World".BalF := 0;
	    "World".BalA := 0;
	    FOR #x := 0 TO 3 DO
	        FOR #y := 0 TO 11 DO
	            IF "World".Bay0[#x, #y] <> 0 THEN
	                IF #x <= 1 THEN
	                    "World".BalL := "World".BalL + 1;
	                ELSE
	                    "World".BalR := "World".BalR + 1;
	                END_IF;
	                IF #y <= 5 THEN
	                    "World".BalF := "World".BalF + 1;
	                ELSE
	                    "World".BalA := "World".BalA + 1;
	                END_IF;
	            END_IF;
	        END_FOR;
	    END_FOR;
	    // Alarm bit 0 while the ship is out of balance (warning; CheckCmd in OB30
	    // blocks every lift/put that would make it worse)
	    IF #Initialized AND (ABS("World".BalL - "World".BalR) > "World".CfgBalLimit
	        OR ("World".CfgBalMode = 1 AND ABS("World".BalF - "World".BalA) > "World".CfgBalLimit))
	    THEN
	        #AlarmLatch := #AlarmLatch OR WORD#16#0001;
	    END_IF;

	    // Planner configuration from the HMI, only while nothing is running
	    IF #State <> 1 AND #State <> 3 AND #State <> 7 THEN
	        IF "HMI_IF".CfgOrderMode <= 2 AND "HMI_IF".CfgOrderMode <> "World".CfgOrderMode THEN
	            "World".CfgOrderMode := "HMI_IF".CfgOrderMode;
	            "World".PlanValid := FALSE;
	        END_IF;
	        IF "HMI_IF".CfgBalMode <= 1 AND "HMI_IF".CfgBalMode <> "World".CfgBalMode THEN
	            "World".CfgBalMode := "HMI_IF".CfgBalMode;
	            "World".PlanValid := FALSE;
	        END_IF;
	    END_IF;
	END_REGION

	REGION 5 Alarms raised by OB30 (World.Fault) and ACK
	    // New OB30 faults: take over and remember where they happened
	    #newFault := "World".Fault AND NOT #AlarmLatch;
	    IF #newFault <> 0 THEN
	        IF (#newFault AND WORD#16#4400) <> 0 THEN      // bit 10 timeout / bit 14 position
	            #cur := "World".ActCmd;
	        ELSE
	            #cur := "World".FaultCmd;
	        END_IF;
	        "HMI_IF".AlarmX := #cur.X;
	        "HMI_IF".AlarmY := #cur.Y;
	        "HMI_IF".AlarmBay := #cur.Bay;
	        "HMI_IF".AlarmId := "World".Carried;
	        IF "World".Carried = 0 AND #cur.X >= 0 AND #cur.X <= 3 AND #cur.Y >= 0 AND #cur.Y <= 11 THEN
	            IF #cur.Bay = 0 THEN
	                "HMI_IF".AlarmId := "World".Bay0[SINT_TO_INT(#cur.X), SINT_TO_INT(#cur.Y)];
	            ELSIF #cur.Bay = 1 THEN
	                "HMI_IF".AlarmId := "World".Bay1[SINT_TO_INT(#cur.X), SINT_TO_INT(#cur.Y)];
	            END_IF;
	        END_IF;
	    END_IF;
	    #AlarmLatch := #AlarmLatch OR "World".Fault;

	    // ACK: clear all latched bits; bits whose cause persists are raised again
	    IF #bAck THEN
	        #hadFault := "World".Fault <> 0;
	        "World".Fault := 0;
	        #AlarmLatch := 0;
	        "HMI_IF".AlarmId := 0;
	        // A runtime fault means the yard may differ from the plan: replan from the
	        // actual state. Exception: a container is on the hook - then the plan is
	        // kept and resumed from the done pointer (the planner cannot start with a load).
	        IF #hadFault AND "World".Carried = 0 THEN
	            "World".PlanValid := FALSE;
	        END_IF;
	        IF #State = 5 THEN
	            "World".Permit := FALSE;
	            "World".CmdReady := FALSE;
	            CASE #PrevState OF
	                1:  // INIT interrupted: start it again
	                    #State := 1;
	                    #InitStep := 0;
	                3, 7:   // was running / planning: "nakon potvrde sustav nastavlja s radom"
	                    IF #Mode = 3 THEN
	                        #State := 4;
	                    ELSIF "World".PlanValid THEN
	                        #State := 3;
	                        #Resync := TRUE;
	                        #SemiTokens := 0;
	                        "World".Permit := TRUE;
	                    ELSE
	                        #State := 7;
	                        #PlanStep := 0;
	                    END_IF;
	                ELSE
	                    #State := #PrevState;      // READY / PAUSED / DONE
	            END_CASE;
	        END_IF;
	    END_IF;
	END_REGION

	REGION 6 Mode selection
	    IF #bAuto THEN #PendMode := 1; END_IF;
	    IF #bSemi THEN #PendMode := 2; END_IF;
	    IF #bManual THEN #PendMode := 3; END_IF;
	    // Applied at once (also while FB1 executes: the command in FB1 always completes),
	    // except during INIT.
	    IF #PendMode <> 0 AND #State <> 1 THEN
	        IF #PendMode = 3 AND #Mode <> 3 AND (#State = 3 OR #State = 7) THEN
	            // MANUAL while running -> PAUSED; withdraw a staged plan command
	            "World".Permit := FALSE;
	            "World".CmdReady := FALSE;
	            #State := 4;
	        END_IF;
	        IF #Mode = 3 AND #PendMode <> 3 AND NOT "World".Busy THEN
	            // leaving MANUAL: withdraw a staged manual command
	            "World".Permit := FALSE;
	            "World".CmdReady := FALSE;
	        END_IF;
	        IF #PendMode <> #Mode THEN
	            #SemiTokens := 0;
	        END_IF;
	        #Mode := #PendMode;
	        #PendMode := 0;
	    END_IF;
	END_REGION

	REGION 7 State machine
	    // ---- OFF / ON (main switch, highest priority) ----
	    IF NOT "HMI_IF".SwOn THEN
	        IF #State <> 0 THEN
	            #OffState := #State;
	            "World".Permit := FALSE;           // first Permit, then withdraw (OB30 preempts OB1)
	            "World".CmdReady := FALSE;
	            #SemiTokens := 0;
	            #State := 0;
	        END_IF;
	    ELSIF #State = 0 THEN
	        IF NOT #Initialized THEN
	            #State := 1;                       // first ON after PLC start -> INIT
	            #InitStep := 0;
	        ELSIF #OffState = 6 THEN
	            #State := 6;
	        ELSE
	            #State := 4;                       // ON after OFF -> PAUSED (START resumes)
	        END_IF;
	    END_IF;

	    // ---- Buttons that change the state ----
	    IF "HMI_IF".SwOn THEN
	        // INITIAL STATE
	        IF #bInit AND #State <> 1 THEN
	            #State := 1;
	            #InitStep := 0;
	        END_IF;

	        // STOP: the command in FB1 completes, a staged one is withdrawn
	        IF #bStop AND (#State = 3 OR #State = 7) THEN
	            "World".Permit := FALSE;
	            "World".CmdReady := FALSE;
	            #SemiTokens := 0;
	            #State := 4;
	        END_IF;

	        // START (AUTO / SEMI)
	        IF #bStart AND NOT #bStop THEN
	            IF NOT #Initialized THEN
	                #AlarmLatch := #AlarmLatch OR WORD#16#2000;            // bit 13 not initialized
	            ELSIF #Mode <> 3 AND (#State = 2 OR #State = 4 OR #State = 6) THEN
	                // With a container on the hook, START is only allowed to finish the
	                // transfer that is in progress (STOP after a lift, then START).
	                #carriedOk := "World".Carried = 0;
	                IF NOT #carriedOk AND "World".PlanValid AND "World".PlanIdx >= 1
	                    AND "World".PlanIdx <= "World".PlanLen AND "World".PlanIdx <= 96
	                    AND "World".Phase >= 2
	                THEN
	                    #carriedOk := "World".Plan["World".PlanIdx].Id = "World".Carried;
	                END_IF;
	                IF NOT #carriedOk THEN
	                    #AlarmLatch := #AlarmLatch OR WORD#16#0800;        // bit 11 crane carrying
	                    "HMI_IF".AlarmId := "World".Carried;
	                    "HMI_IF".AlarmX := "World".CraneX;
	                    "HMI_IF".AlarmY := "World".CraneY;
	                    "HMI_IF".AlarmBay := "World".CraneBay;
	                ELSIF "World".PlanValid THEN
	                    IF #State <> 6 THEN                                // DONE + valid plan: nothing to do
	                        #State := 3;
	                        #Resync := TRUE;
	                        #SemiTokens := 0;
	                        "World".Permit := TRUE;
	                    END_IF;
	                ELSE
	                    #State := 7;                                       // plan first
	                    #PlanStep := 0;
	                END_IF;
	            END_IF;
	        END_IF;
	    END_IF;

	    // ---- Blocking alarm -> ALARM ----
	    // blocking bits: 1, 2, 7, 8, 10, 11, 12 and every fault detected by OB30
	    #blocking := (#AlarmLatch AND WORD#16#1D86) <> 0 OR "World".Fault <> 0;
	    IF #blocking AND #State <> 0 AND #State <> 5 AND NOT (#State = 1 AND #InitStep = 0) THEN
	        #PrevState := #State;
	        "World".Permit := FALSE;
	        "World".CmdReady := FALSE;
	        #SemiTokens := 0;
	        #State := 5;
	    END_IF;

	    CASE #State OF
	        0:  // ---------------- OFF ----------------
	            ;

	        1:  // ---------------- INIT (CONTRACT 3.2) ----------------
	            CASE #InitStep OF
	                0:  // stop everything, clear alarms
	                    "World".Permit := FALSE;
	                    "World".CmdReady := FALSE;
	                    "World".Fault := 0;
	                    #AlarmLatch := 0;
	                    "HMI_IF".AlarmId := 0;
	                    #Initialized := FALSE;
	                    "World".PlanValid := FALSE;
	                    #SemiTokens := 0;
	                    #InitStep := 1;

	                1:  // wait for FB1, then stage the reset command (10)
	                    IF NOT "World".Busy AND NOT "World".CmdReady THEN
	                        "World".NextCmd.Cmd := 10;
	                        "World".NextCmd.X := 0;
	                        "World".NextCmd.Y := 0;
	                        "World".NextCmd.Bay := 1;
	                        "World".NextCmd.Src := 4;
	                        "World".NextCmd.TrIdx := 0;
	                        "World".NextCmd.Phase := 0;
	                        #InitSeq := "World".DoneSeq;
	                        "World".Permit := TRUE;
	                        "World".CmdReady := TRUE;      // last: hands the command to OB30
	                        #InitStep := 2;
	                    END_IF;

	                2:  // wait until OB30 reports the reset as done
	                    IF "World".DoneSeq <> #InitSeq AND NOT "World".Busy AND "World".LastDone.Cmd = 10 THEN
	                        "World".Permit := FALSE;
	                        #InitStep := 3;
	                    END_IF;

	                3:  // copy the yard and the lists, validate (all warnings except capacity)
	                    FOR #x := 0 TO 3 DO
	                        FOR #y := 0 TO 11 DO
	                            "World".Bay0[#x, #y] := "Current_state_of_Bay0".Bay0[#x, #y];
	                            "World".Bay1[#x, #y] := "Current_state_of_Bay1".Bay1[#x, #y];
	                            #tc[#x * 12 + #y] := "World".Bay0[#x, #y];
	                            #tc[48 + #x * 12 + #y] := "World".Bay1[#x, #y];
	                        END_FOR;
	                    END_FOR;
	                    "World".Carried := 0;
	                    "World".CraneX := "x_position";
	                    "World".CraneY := "y_position";
	                    "World".CraneBay := "bay_ID";

	                    // cells: invalid IDs (bit 5) and duplicates (bit 6)
	                    FOR #i := 0 TO 95 DO
	                        #id := #tc[#i];
	                        IF #id <> 0 THEN
	                            IF #id < 100 OR #id > 999 THEN
	                                #AlarmLatch := #AlarmLatch OR WORD#16#0020;
	                                "HMI_IF".AlarmId := #id;
	                                "HMI_IF".AlarmBay := INT_TO_USINT(#i / 48);
	                                "HMI_IF".AlarmX := INT_TO_SINT((#i MOD 48) / 12);
	                                "HMI_IF".AlarmY := INT_TO_SINT(#i MOD 12);
	                            END_IF;
	                            FOR #j := #i + 1 TO 95 DO
	                                IF #tc[#j] = #id THEN
	                                    #AlarmLatch := #AlarmLatch OR WORD#16#0040;
	                                    "HMI_IF".AlarmId := #id;
	                                    "HMI_IF".AlarmBay := INT_TO_USINT(#j / 48);
	                                    "HMI_IF".AlarmX := INT_TO_SINT((#j MOD 48) / 12);
	                                    "HMI_IF".AlarmY := INT_TO_SINT(#j MOD 12);
	                                END_IF;
	                            END_FOR;
	                        END_IF;
	                    END_FOR;

	                    // lists: UList 1..48 then LList 1..48 (same order as tools/crane_model.py)
	                    "World".N := 0;
	                    FOR #i := 1 TO 48 DO
	                        "World".UList[#i] := "From_Bay0_to_Bay1".IDs_of_the_containers[#i];
	                        "World".LList[#i] := "From_Bay1_to_Bay0".Bay1_IDs_of_the_containers[#i];
	                        #tl[#i] := "World".UList[#i];
	                        #tl[48 + #i] := "World".LList[#i];
	                        IF "World".UList[#i] <> 0 THEN "World".N := "World".N + 1; END_IF;
	                        IF "World".LList[#i] <> 0 THEN "World".N := "World".N + 1; END_IF;
	                    END_FOR;
	                    FOR #i := 1 TO 96 DO
	                        #id := #tl[#i];
	                        IF #id = 0 THEN
	                            #ts[#i] := 2;                                  // empty entry (silent)
	                        ELSIF #id < 100 OR #id > 999 THEN
	                            #ts[#i] := 2;                                  // invalid ID
	                            #AlarmLatch := #AlarmLatch OR WORD#16#0020;
	                            "HMI_IF".AlarmId := #id;
	                        ELSE
	                            #found := FALSE;                               // seen in an earlier entry?
	                            FOR #j := 1 TO #i - 1 DO
	                                IF #tl[#j] = #id THEN #found := TRUE; END_IF;
	                            END_FOR;
	                            IF #found THEN
	                                #ts[#i] := 2;                              // duplicate
	                                #AlarmLatch := #AlarmLatch OR WORD#16#0040;
	                                "HMI_IF".AlarmId := #id;
	                            ELSE
	                                #found := FALSE;                           // in its source bay?
	                                FOR #x := 0 TO 3 DO
	                                    FOR #y := 0 TO 11 DO
	                                        IF #i <= 48 THEN
	                                            IF "World".Bay0[#x, #y] = #id THEN #found := TRUE; END_IF;
	                                        ELSE
	                                            IF "World".Bay1[#x, #y] = #id THEN #found := TRUE; END_IF;
	                                        END_IF;
	                                    END_FOR;
	                                END_FOR;
	                                IF #found THEN
	                                    #ts[#i] := 0;                          // pending
	                                ELSE
	                                    #ts[#i] := 2;
	                                    IF #i <= 48 THEN
	                                        #AlarmLatch := #AlarmLatch OR WORD#16#0008;  // bit 3 unload ID not in Bay 0
	                                        "HMI_IF".AlarmBay := 0;
	                                    ELSE
	                                        #AlarmLatch := #AlarmLatch OR WORD#16#0010;  // bit 4 load ID not in Bay 1
	                                        "HMI_IF".AlarmBay := 1;
	                                    END_IF;
	                                    "HMI_IF".AlarmId := #id;
	                                    "HMI_IF".AlarmX := -1;
	                                    "HMI_IF".AlarmY := -1;
	                                END_IF;
	                            END_IF;
	                        END_IF;
	                    END_FOR;
	                    #pu := 0;
	                    #pl := 0;
	                    FOR #i := 1 TO 48 DO
	                        "World".UState[#i] := #ts[#i];
	                        "World".LState[#i] := #ts[48 + #i];
	                        IF #ts[#i] = 0 THEN #pu := #pu + 1; END_IF;
	                        IF #ts[48 + #i] = 0 THEN #pl := #pl + 1; END_IF;
	                    END_FOR;

	                    // capacity (blocking, bit 7)
	                    #cnt := 0;      // occupied Bay0
	                    #cnt2 := 0;     // occupied Bay1
	                    FOR #i := 0 TO 47 DO
	                        IF #tc[#i] <> 0 THEN #cnt := #cnt + 1; END_IF;
	                        IF #tc[48 + #i] <> 0 THEN #cnt2 := #cnt2 + 1; END_IF;
	                    END_FOR;
	                    IF #cnt2 - #pl + #pu > 48 OR #cnt - #pu + #pl > 48 THEN
	                        #AlarmLatch := #AlarmLatch OR WORD#16#0080;
	                        #Initialized := FALSE;
	                        #PrevState := 2;
	                        #State := 5;                   // ALARM; ACK -> READY (not initialized)
	                    ELSE
	                        // initial imbalance is only a warning (bit 0 is raised in region 4)
	                        #InitStep := 4;
	                    END_IF;

	                4:  // request the plan (planner idle, crane empty)
	                    IF NOT "World".Busy AND #SeenSeq = "World".DoneSeq
	                        AND NOT #PlanReq AND NOT #Planner.Busy AND NOT #Planner.Done AND NOT #Planner.Error
	                    THEN
	                        "World".BaseT_ds := ROUND("time" * 10.0);
	                        "World".BaseM := UDINT_TO_DINT("number_of_manipulations");
	                        #PlanCrX := "World".CraneX;
	                        #PlanCrY := "World".CraneY;
	                        #PlanCrBay := "World".CraneBay;
	                        #PlanFinished := FALSE;
	                        #PlanReq := TRUE;
	                        #InitStep := 5;
	                    END_IF;

	                5:  // wait for the planner
	                    IF #PlanFinished THEN
	                        #PlanFinished := FALSE;
	                        #Initialized := TRUE;          // yard copied: MANUAL is possible even if planning failed
	                        IF #PlanOk THEN
	                            #State := 2;               // READY
	                        ELSE
	                            "World".PlanValid := FALSE;
	                            #AlarmLatch := #AlarmLatch OR WORD#16#0100;   // bit 8 plan infeasible
	                            #PrevState := 2;
	                            #State := 5;
	                        END_IF;
	                    END_IF;

	                ELSE
	                    #InitStep := 0;
	            END_CASE;

	        2:  // ---------------- READY ----------------
	            ;   // waits for START (region above) or MANUAL commands (region 8)

	        3:  // ---------------- RUNNING ----------------
	            IF NOT "World".PlanValid THEN
	                #State := 7;                   // plan invalidated -> replan
	                #PlanStep := 0;
	            ELSIF "World".PlanIdx > "World".PlanLen AND NOT "World".Busy AND NOT "World".CmdReady THEN
	                #cnt := 0;
	                FOR #i := 1 TO 48 DO
	                    IF "World".UState[#i] = 0 THEN #cnt := #cnt + 1; END_IF;
	                    IF "World".LState[#i] = 0 THEN #cnt := #cnt + 1; END_IF;
	                END_FOR;
	                IF #cnt = 0 THEN
	                    "World".Permit := FALSE;
	                    #AlarmLatch := #AlarmLatch OR WORD#16#8000;   // bit 15 finished (info)
	                    #State := 6;               // DONE
	                ELSE
	                    "World".PlanValid := FALSE;   // entries still pending -> replan
	                    #State := 7;
	                    #PlanStep := 0;
	                END_IF;
	            END_IF;

	        4:  // ---------------- PAUSED ----------------
	            ;

	        5:  // ---------------- ALARM ----------------
	            ;   // leaves on ACK (region 5) or INIT

	        6:  // ---------------- DONE ----------------
	            ;

	        7:  // ---------------- PLANNING ----------------
	            CASE #PlanStep OF
	                0:  // nothing may be issued while planning
	                    "World".Permit := FALSE;
	                    "World".CmdReady := FALSE;
	                    #PlanStep := 1;
	                1:  // wait for FB1 and an idle planner, then request
	                    // NOT Busy first, then SeenSeq = DoneSeq: list states include the last PUT
	                    IF NOT "World".Busy AND #SeenSeq = "World".DoneSeq AND NOT #PlanReq AND NOT #Planner.Busy
	                        AND NOT #Planner.Done AND NOT #Planner.Error
	                    THEN
	                        IF "World".Carried <> 0 THEN
	                            // the planner needs an empty hook: put it down in MANUAL first
	                            #AlarmLatch := #AlarmLatch OR WORD#16#0800;   // bit 11
	                            "HMI_IF".AlarmId := "World".Carried;
	                            #PrevState := 4;
	                            #State := 5;
	                        ELSE
	                            "World".BaseT_ds := ROUND("time" * 10.0);
	                            "World".BaseM := UDINT_TO_DINT("number_of_manipulations");
	                            #PlanCrX := "World".CraneX;
	                            #PlanCrY := "World".CraneY;
	                            #PlanCrBay := "World".CraneBay;
	                            #PlanFinished := FALSE;
	                            #PlanReq := TRUE;
	                            #PlanStep := 2;
	                        END_IF;
	                    END_IF;
	                2:  // wait for the result
	                    IF #PlanFinished THEN
	                        #PlanFinished := FALSE;
	                        IF #PlanOk THEN
	                            IF #Mode = 3 THEN
	                                #State := 4;
	                            ELSE
	                                #State := 3;
	                                #Resync := TRUE;
	                                #SemiTokens := 0;
	                                "World".Permit := TRUE;
	                            END_IF;
	                        ELSE
	                            "World".PlanValid := FALSE;
	                            #AlarmLatch := #AlarmLatch OR WORD#16#0100;   // bit 8 plan infeasible
	                            #PrevState := 4;
	                            #State := 5;
	                        END_IF;
	                    END_IF;
	                ELSE
	                    #PlanStep := 0;
	            END_CASE;

	        ELSE
	            #State := 0;
	    END_CASE;
	END_REGION

	REGION 8 New plan: done pointer, staging cursor, skip rule
	    // Runs once when a plan was just accepted (INIT step 5 / PLANNING step 2 set PlanFinished := FALSE
	    // and PlanOk = TRUE in this cycle). The pointers are set from the plan-time crane position.
	    IF #PlanOk AND NOT #PlanFinished AND NOT #PlanReq AND "World".PlanValid
	        AND ((#State = 2 AND #InitStep = 5) OR ((#State = 3 OR #State = 4) AND #PlanStep = 2))
	    THEN
	        IF "World".PlanLen > 96 THEN
	            "World".PlanLen := 96;
	        END_IF;
	        // Skip rule (CONTRACT 3.4): move-to-src is skipped when the crane is already there
	        FOR #i := 1 TO "World".PlanLen DO
	            IF #i = 1 THEN
	                #found := #PlanCrX = "World".Plan[1].SrcX AND #PlanCrY = "World".Plan[1].SrcY
	                          AND #PlanCrBay = "World".Plan[1].SrcBay;
	            ELSE
	                #found := "World".Plan[#i - 1].DstX = "World".Plan[#i].SrcX
	                          AND "World".Plan[#i - 1].DstY = "World".Plan[#i].SrcY
	                          AND "World".Plan[#i - 1].DstBay = "World".Plan[#i].SrcBay;
	            END_IF;
	            IF #found THEN
	                #FirstPh[#i] := 1;
	            ELSE
	                #FirstPh[#i] := 0;
	            END_IF;
	        END_FOR;
	        "World".PlanIdx := 1;
	        IF "World".PlanLen >= 1 THEN
	            "World".Phase := #FirstPh[1];
	        ELSE
	            "World".Phase := 0;
	        END_IF;
	        "World".StageIdx := 1;
	        "World".StagePhase := "World".Phase;
	        #InitStep := 6;                        // INIT finished
	        #PlanStep := 3;                        // PLANNING finished
	        #PlanOk := FALSE;                      // consumed
	    END_IF;
	END_REGION

	REGION 9 Staging: AUTO / SEMI plan commands, MANUAL commands
	    // ---- AUTO / SEMI: next plan command (at most one staged ahead of FB1) ----
	    IF #State = 3 AND #Mode <> 3 AND "World".PlanValid AND "World".Permit THEN
	        // After START / ACK: continue exactly from the done pointer
	        // (NOT Busy first, then SeenSeq = DoneSeq: every completion is already counted)
	        IF #Resync AND NOT "World".Busy AND #SeenSeq = "World".DoneSeq AND NOT "World".CmdReady THEN
	            "World".StageIdx := "World".PlanIdx;
	            "World".StagePhase := "World".Phase;
	            #Resync := FALSE;
	        END_IF;

	        // SEMI: one click = one command (or the rest of one transfer)
	        IF #Mode = 2 AND #bStep AND NOT #Resync AND #SemiTokens = 0
	            AND NOT "World".Busy AND NOT "World".CmdReady
	        THEN
	            IF "HMI_IF".CfgSemiPerTransfer THEN
	                #SemiTokens := 4 - USINT_TO_INT("World".StagePhase);
	            ELSE
	                #SemiTokens := 1;
	            END_IF;
	        END_IF;

	        IF NOT #Resync AND NOT "World".CmdReady
	            AND "World".StageIdx >= 1 AND "World".StageIdx <= "World".PlanLen AND "World".StageIdx <= 96
	            AND (#Mode = 1 OR #SemiTokens > 0)
	        THEN
	            #tr := "World".Plan["World".StageIdx];
	            CASE "World".StagePhase OF
	                0:  "World".NextCmd.Cmd := 3;          // move to source
	                1:  "World".NextCmd.Cmd := 1;          // lift
	                2:  "World".NextCmd.Cmd := 3;          // move to destination
	                ELSE
	                    "World".NextCmd.Cmd := 2;          // put down
	            END_CASE;
	            IF "World".StagePhase <= 1 THEN
	                "World".NextCmd.X := #tr.SrcX;
	                "World".NextCmd.Y := #tr.SrcY;
	                "World".NextCmd.Bay := #tr.SrcBay;
	            ELSE
	                "World".NextCmd.X := #tr.DstX;
	                "World".NextCmd.Y := #tr.DstY;
	                "World".NextCmd.Bay := #tr.DstBay;
	            END_IF;
	            "World".NextCmd.Src := #Mode;              // 1 AUTO, 2 SEMI
	            "World".NextCmd.TrIdx := "World".StageIdx;
	            "World".NextCmd.Phase := "World".StagePhase;
	            "World".CmdReady := TRUE;                  // last: hands the command to OB30

	            // advance the staging cursor
	            IF "World".StagePhase >= 3 THEN
	                "World".StageIdx := "World".StageIdx + 1;
	                IF "World".StageIdx <= "World".PlanLen AND "World".StageIdx <= 96 THEN
	                    "World".StagePhase := #FirstPh["World".StageIdx];
	                ELSE
	                    "World".StagePhase := 0;
	                END_IF;
	            ELSE
	                "World".StagePhase := "World".StagePhase + 1;
	            END_IF;
	            IF #Mode = 2 AND #SemiTokens > 0 THEN
	                #SemiTokens := #SemiTokens - 1;
	            END_IF;
	        END_IF;
	    END_IF;

	    // ---- MANUAL: command from the HMI fields ----
	    IF #bManExec AND #Mode = 3 AND "HMI_IF".SwOn THEN
	        IF NOT #Initialized THEN
	            #AlarmLatch := #AlarmLatch OR WORD#16#2000;            // bit 13 not initialized
	        ELSIF (#State = 2 OR #State = 4 OR #State = 6) AND NOT #blocking
	            AND NOT "World".Busy AND NOT "World".CmdReady
	        THEN
	            IF NOT ("HMI_IF".ManCmd = 1 OR "HMI_IF".ManCmd = 2 OR "HMI_IF".ManCmd = 3 OR "HMI_IF".ManCmd = 10)
	                OR ("HMI_IF".ManCmd = 3 AND ("HMI_IF".ManX < 0 OR "HMI_IF".ManX > 3
	                    OR "HMI_IF".ManY < 0 OR "HMI_IF".ManY > 11 OR "HMI_IF".ManBay > 1))
	            THEN
	                // invalid manual input: warning, the command is dropped
	                #AlarmLatch := #AlarmLatch OR WORD#16#0200;        // bit 9
	                "HMI_IF".AlarmId := 0;
	                "HMI_IF".AlarmX := "HMI_IF".ManX;
	                "HMI_IF".AlarmY := "HMI_IF".ManY;
	                "HMI_IF".AlarmBay := "HMI_IF".ManBay;
	            ELSIF "HMI_IF".ManCmd = 3 AND "HMI_IF".ManX = "World".CraneX AND "HMI_IF".ManY = "World".CraneY
	                AND "HMI_IF".ManBay = "World".CraneBay
	            THEN
	                ;   // zero-distance move: FB1 would add 1 manipulation for nothing -> dropped
	            ELSE
	                "World".NextCmd.Cmd := "HMI_IF".ManCmd;
	                IF "HMI_IF".ManCmd = 3 THEN
	                    "World".NextCmd.X := "HMI_IF".ManX;
	                    "World".NextCmd.Y := "HMI_IF".ManY;
	                    "World".NextCmd.Bay := "HMI_IF".ManBay;
	                ELSIF "HMI_IF".ManCmd = 10 THEN
	                    "World".NextCmd.X := 0;
	                    "World".NextCmd.Y := 0;
	                    "World".NextCmd.Bay := 1;
	                ELSE    // lift / put: where the crane is
	                    "World".NextCmd.X := "World".CraneX;
	                    "World".NextCmd.Y := "World".CraneY;
	                    "World".NextCmd.Bay := "World".CraneBay;
	                END_IF;
	                "World".NextCmd.Src := 3;
	                "World".NextCmd.TrIdx := 0;
	                "World".NextCmd.Phase := 0;
	                "World".Permit := TRUE;
	                "World".CmdReady := TRUE;              // last
	            END_IF;
	        END_IF;
	    END_IF;
	END_REGION

	REGION 10 Discard a planner result nobody waits for (STOP / OFF / INIT during planning)
	    IF #PlanFinished AND NOT (#State = 1 AND #InitStep = 5) AND NOT (#State = 7 AND #PlanStep = 2) THEN
	        #PlanFinished := FALSE;
	        #PlanOk := FALSE;
	        "World".PlanValid := FALSE;
	    END_IF;
	END_REGION

	REGION 11 Alarm history (ring, [0] newest)
	    #newBits := #AlarmLatch AND NOT #AlarmPrev;
	    IF #newBits <> 0 THEN
	        FOR #b := 0 TO 15 DO
	            IF (#newBits AND SHL(IN := WORD#16#0001, N := INT_TO_UINT(#b))) <> 0 THEN
	                FOR #k := 15 TO 1 BY -1 DO
	                    "HMI_IF".AlarmHist[#k] := "HMI_IF".AlarmHist[#k - 1];
	                    #AlarmHistM[#k] := #AlarmHistM[#k - 1];
	                    #AlarmHistT[#k] := #AlarmHistT[#k - 1];
	                END_FOR;
	                "HMI_IF".AlarmHist[0] := #b;
	                #AlarmHistM[0] := "number_of_manipulations";
	                #AlarmHistT[0] := "time";
	                "HMI_IF".AlarmHistSeq := "HMI_IF".AlarmHistSeq + 1;
	            END_IF;
	        END_FOR;
	    END_IF;
	    #AlarmPrev := #AlarmLatch;
	END_REGION

	REGION 12 HMI indicators (every cycle)
	    // ---- state, mode, lamps ----
	    #blocking := (#AlarmLatch AND WORD#16#1D86) <> 0 OR "World".Fault <> 0;
	    "HMI_IF".State := #State;
	    "HMI_IF".Mode := #Mode;
	    "HMI_IF".LampOn := "HMI_IF".SwOn;
	    "HMI_IF".LampOff := NOT "HMI_IF".SwOn;
	    "HMI_IF".LampReady := "HMI_IF".SwOn AND #Initialized AND NOT #blocking
	                          AND (#State = 2 OR #State = 3 OR #State = 4 OR #State = 6);
	    "HMI_IF".LampAuto := #Mode = 1;
	    "HMI_IF".LampSemi := #Mode = 2;
	    "HMI_IF".LampManual := #Mode = 3;
	    "HMI_IF".LampRunning := #State = 3;
	    "HMI_IF".LampAlarm := (#AlarmLatch AND WORD#16#7FFF) <> 0;
	    "HMI_IF".LampDone := #State = 6;
	    "HMI_IF".Initialized := #Initialized;
	    "HMI_IF".CraneBusy := "World".Busy;
	    "HMI_IF".Planning := #State = 7 OR #Planner.Busy;
	    "HMI_IF".StepWaiting := #State = 3 AND #Mode = 2 AND #SemiTokens = 0
	                            AND NOT "World".Busy AND NOT "World".CmdReady
	                            AND "World".StageIdx <= "World".PlanLen;
	    "HMI_IF".AlarmWord := #AlarmLatch;
	    "HMI_IF".OB30Ticks := "World".OB30Ticks;

	    // ---- score: M, T and J = 0.5*T/(76*N) + 0.5*M/(4*N) ----
	    "HMI_IF".M := "number_of_manipulations";
	    "HMI_IF".T := "time";
	    "HMI_IF".N := "World".N;
	    IF "World".N > 0 THEN
	        #rN := INT_TO_REAL("World".N);
	        "HMI_IF".J := 0.5 * "time" / (76.0 * #rN) + 0.5 * UDINT_TO_REAL("number_of_manipulations") / (4.0 * #rN);
	    ELSE
	        "HMI_IF".J := 0.0;
	    END_IF;
	    "HMI_IF".PredM := "World".PredM;
	    "HMI_IF".PredT := DINT_TO_REAL("World".PredT_ds) / 10.0;
	    "HMI_IF".PredJ := "World".PredJ;
	    "HMI_IF".PlanVariant := "World".PlanVariant;

	    // ---- crane ----
	    "HMI_IF".CraneX := "World".CraneX;
	    "HMI_IF".CraneY := "World".CraneY;
	    "HMI_IF".CraneBay := "World".CraneBay;
	    IF "World".CraneBay = 0 THEN
	        "HMI_IF".CraneGX := SINT_TO_INT("World".CraneX) + 6;
	    ELSE
	        "HMI_IF".CraneGX := SINT_TO_INT("World".CraneX);
	    END_IF;
	    "HMI_IF".Carried := "World".Carried;

	    // ---- current command and transfer ----
	    IF "World".Busy THEN
	        #cur := "World".ActCmd;
	    ELSIF "World".CmdReady THEN
	        #cur := "World".NextCmd;
	    ELSE
	        #cur := "World".LastDone;
	    END_IF;
	    "HMI_IF".CurCmd := #cur.Cmd;
	    "HMI_IF".CurX := #cur.X;
	    "HMI_IF".CurY := #cur.Y;
	    "HMI_IF".CurBay := #cur.Bay;
	    "HMI_IF".CurPhase := "World".Phase;
	    #curValid := "World".PlanValid AND "World".PlanIdx >= 1 AND "World".PlanIdx <= "World".PlanLen
	                 AND "World".PlanIdx <= 96 AND (#State = 3 OR #State = 4 OR #State = 5);
	    IF #curValid THEN
	        #tr := "World".Plan["World".PlanIdx];
	        "HMI_IF".CurId := #tr.Id;
	        "HMI_IF".CurKind := #tr.Kind;
	    ELSE
	        "HMI_IF".CurId := "World".Carried;
	        "HMI_IF".CurKind := 0;
	    END_IF;

	    // ---- lists and progress ----
	    "HMI_IF".UDone := 0;
	    "HMI_IF".UTotal := 0;
	    "HMI_IF".LDone := 0;
	    "HMI_IF".LTotal := 0;
	    FOR #i := 1 TO 48 DO
	        "HMI_IF".UList[#i] := "World".UList[#i];
	        "HMI_IF".LList[#i] := "World".LList[#i];
	        "HMI_IF".UState[#i] := "World".UState[#i];
	        "HMI_IF".LState[#i] := "World".LState[#i];
	        IF "World".UState[#i] <= 1 THEN "HMI_IF".UTotal := "HMI_IF".UTotal + 1; END_IF;
	        IF "World".UState[#i] = 1 THEN "HMI_IF".UDone := "HMI_IF".UDone + 1; END_IF;
	        IF "World".LState[#i] <= 1 THEN "HMI_IF".LTotal := "HMI_IF".LTotal + 1; END_IF;
	        IF "World".LState[#i] = 1 THEN "HMI_IF".LDone := "HMI_IF".LDone + 1; END_IF;
	    END_FOR;
	    IF NOT #Initialized THEN
	        "HMI_IF".UTotal := 0;
	        "HMI_IF".LTotal := 0;
	        "HMI_IF".UDone := 0;
	        "HMI_IF".LDone := 0;
	    END_IF;
	    "HMI_IF".TrDone := "HMI_IF".UDone + "HMI_IF".LDone;
	    "HMI_IF".TrTotal := "HMI_IF".UTotal + "HMI_IF".LTotal;
	    // entry of the transfer in progress (lifted or being fetched)
	    IF #curValid AND ("World".Phase >= 1 OR ("World".Busy AND "World".ActCmd.TrIdx = "World".PlanIdx)) THEN
	        IF #tr.ListIdx >= 1 AND #tr.ListIdx <= 48 THEN
	            IF #tr.Kind = 1 AND "World".UState[#tr.ListIdx] = 0 THEN
	                "HMI_IF".UState[#tr.ListIdx] := 3;
	            ELSIF #tr.Kind = 2 AND "World".LState[#tr.ListIdx] = 0 THEN
	                "HMI_IF".LState[#tr.ListIdx] := 3;
	            END_IF;
	        END_IF;
	    END_IF;

	    // ---- balance ----
	    "HMI_IF".BalL := "World".BalL;
	    "HMI_IF".BalR := "World".BalR;
	    "HMI_IF".BalDiff := "World".BalL - "World".BalR;
	    "HMI_IF".BalF := "World".BalF;
	    "HMI_IF".BalA := "World".BalA;
	    "HMI_IF".BalOk := ABS("World".BalL - "World".BalR) <= "World".CfgBalLimit;

	    // ---- grids: IDs and colour codes, index x*12 + y ----
	    // Before INIT the given DB10/DB11 are shown; afterwards our container model.
	    FOR #x := 0 TO 3 DO
	        FOR #y := 0 TO 11 DO
	            #k := #x * 12 + #y;
	            IF #Initialized THEN
	                "HMI_IF".Cell0[#k] := "World".Bay0[#x, #y];
	                "HMI_IF".Cell1[#k] := "World".Bay1[#x, #y];
	            ELSE
	                "HMI_IF".Cell0[#k] := "Current_state_of_Bay0".Bay0[#x, #y];
	                "HMI_IF".Cell1[#k] := "Current_state_of_Bay1".Bay1[#x, #y];
	            END_IF;
	            // 0 empty, 1 occupied, 7 invalid ID
	            #id := "HMI_IF".Cell0[#k];
	            IF #id = 0 THEN
	                "HMI_IF".CellSt0[#k] := 0;
	            ELSIF #id < 100 OR #id > 999 THEN
	                "HMI_IF".CellSt0[#k] := 7;
	            ELSE
	                "HMI_IF".CellSt0[#k] := 1;
	            END_IF;
	            #id := "HMI_IF".Cell1[#k];
	            IF #id = 0 THEN
	                "HMI_IF".CellSt1[#k] := 0;
	            ELSIF #id < 100 OR #id > 999 THEN
	                "HMI_IF".CellSt1[#k] := 7;
	            ELSE
	                "HMI_IF".CellSt1[#k] := 1;
	            END_IF;
	        END_FOR;
	    END_FOR;
	    IF #Initialized THEN
	        // list containers: 2 pending unload (Bay0), 3 pending load (Bay1), 4 transferred
	        FOR #i := 1 TO 48 DO
	            #id := "World".UList[#i];
	            IF #id >= 100 AND #id <= 999 AND "World".UState[#i] <= 1 THEN
	                FOR #k := 0 TO 47 DO
	                    IF "World".UState[#i] = 0 AND "HMI_IF".Cell0[#k] = #id THEN
	                        "HMI_IF".CellSt0[#k] := 2;
	                    ELSIF "World".UState[#i] = 1 AND "HMI_IF".Cell1[#k] = #id THEN
	                        "HMI_IF".CellSt1[#k] := 4;
	                    END_IF;
	                END_FOR;
	            END_IF;
	            #id := "World".LList[#i];
	            IF #id >= 100 AND #id <= 999 AND "World".LState[#i] <= 1 THEN
	                FOR #k := 0 TO 47 DO
	                    IF "World".LState[#i] = 0 AND "HMI_IF".Cell1[#k] = #id THEN
	                        "HMI_IF".CellSt1[#k] := 3;
	                    ELSIF "World".LState[#i] = 1 AND "HMI_IF".Cell0[#k] = #id THEN
	                        "HMI_IF".CellSt0[#k] := 4;
	                    END_IF;
	                END_FOR;
	            END_IF;
	        END_FOR;
	        // current transfer: 5 source (container still there), 6 destination (still empty)
	        IF #curValid THEN
	            IF #tr.SrcX >= 0 AND #tr.SrcX <= 3 AND #tr.SrcY >= 0 AND #tr.SrcY <= 11 THEN
	                #k := SINT_TO_INT(#tr.SrcX) * 12 + SINT_TO_INT(#tr.SrcY);
	                IF #tr.SrcBay = 0 AND "HMI_IF".Cell0[#k] <> 0 THEN
	                    "HMI_IF".CellSt0[#k] := 5;
	                ELSIF #tr.SrcBay = 1 AND "HMI_IF".Cell1[#k] <> 0 THEN
	                    "HMI_IF".CellSt1[#k] := 5;
	                END_IF;
	            END_IF;
	            IF #tr.DstX >= 0 AND #tr.DstX <= 3 AND #tr.DstY >= 0 AND #tr.DstY <= 11 THEN
	                #k := SINT_TO_INT(#tr.DstX) * 12 + SINT_TO_INT(#tr.DstY);
	                IF #tr.DstBay = 0 AND "HMI_IF".Cell0[#k] = 0 THEN
	                    "HMI_IF".CellSt0[#k] := 6;
	                ELSIF #tr.DstBay = 1 AND "HMI_IF".Cell1[#k] = 0 THEN
	                    "HMI_IF".CellSt1[#k] := 6;
	                END_IF;
	            END_IF;
	        END_IF;
	    END_IF;
	END_REGION
END_FUNCTION_BLOCK

